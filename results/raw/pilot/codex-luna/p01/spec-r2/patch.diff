+"""Convert authored Markdown into the existing knowledge bundle records."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    kind: DocumentKind
+    title: str
+    source: SourceInfo
+    markdown: str
+    attributes: Mapping[str, str | int | float | bool | None] | None = None
+
+
+@dataclass(frozen=True)
+class AuthoredSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Return a lowercase, ASCII, hyphen-separated slug."""
+    text = text.replace("Đ", "D").replace("đ", "d")
+    text = unicodedata.normalize("NFKD", text)
+    ascii_text = text.encode("ascii", "ignore").decode("ascii").lower()
+    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
+    return slug[:max_length].rstrip("-") if max_length > 0 else ""
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    slug_path = "/".join(part for item in path if (part := slugify(item)))
+    return f"{document_key}#{slug_path or 'body'}"
+
+
+def section_choices(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, str]]:
+    choices: list[tuple[str, str]] = []
+    for document in documents:
+        qualified_key = f"{collection.key}:{document.key}"
+        for section in split_markdown(
+            document.markdown, fallback_heading=document.title
+        ):
+            label = " › ".join((document.title, *section.path))
+            choices.append((section_key(qualified_key, section.path), label))
+    return choices
+
+
+def build_bundle(
+    collection: BundleCollection,
+    documents: Sequence[AuthoredDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    """Build deterministic existing-format records from authored Markdown."""
+    ordered_docs = sorted(documents, key=lambda item: f"{collection.key}:{item.key}")
+    document_records: list[DocumentRecord] = []
+    section_records: list[SectionRecord] = []
+    for document in ordered_docs:
+        qualified_key = f"{collection.key}:{document.key}"
+        document_records.append(
+            DocumentRecord(
+                key=qualified_key,
+                kind=document.kind,
+                title=document.title,
+                source=document.source,
+                attributes=dict(document.attributes or {}),
+            )
+        )
+        for section in split_markdown(
+            document.markdown, fallback_heading=document.title
+        ):
+            section_records.append(
+                SectionRecord(
+                    key=section_key(qualified_key, section.path),
+                    document_key=qualified_key,
+                    heading=section.heading,
+                    context_path=list(section.path),
+                    ordinal=section.ordinal,
+                    blocks=section.blocks,
+                )
+            )
+    section_keys = {section.key for section in section_records}
+    mappings = [
+        mapping.model_copy(
+            update={
+                "section_keys": [
+                    key for key in mapping.section_keys if key in section_keys
+                ]
+            }
+        )
+        for mapping in colloquial
+    ]
+    manifest = BundleManifest(
+        schema_version="knowledge-bundle/v1",
+        collection=collection,
+        generator=BundleGenerator(
+            name="pharma-agent-authoring", version="1", build_id="deterministic"
+        ),
+        source_digests={},
+        document_count=len(document_records),
+        section_count=len(section_records),
+        files={},
+        embeddings=[],
+    )
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=document_records,
+        sections=section_records,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
+
+
+def _heading_level(line: str) -> tuple[int, str] | None:
+    stripped = line.lstrip()
+    count = len(stripped) - len(stripped.lstrip("#"))
+    if 1 <= count <= 6 and len(stripped) > count and stripped[count].isspace():
+        heading = stripped[count:].strip().rstrip("#").strip()
+        if heading:
+            return count, heading
+    return None
+
+
+def _split_blocks(lines: list[str], next_table: int) -> tuple[list[BlockRecord], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        prose.clear()
+
+    index = 0
+    while index < len(lines):
+        if lines[index].startswith("|"):
+            flush_prose()
+            table: list[str] = []
+            while index < len(lines) and lines[index].startswith("|"):
+                table.append(lines[index].rstrip())
+                index += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(table).strip(),
+                    table_key=f"t{next_table}",
+                )
+            )
+            next_table += 1
+        else:
+            prose.append(lines[index])
+            index += 1
+    flush_prose()
+    return blocks, next_table
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[AuthoredSection]:
+    """Split authored Markdown into heading sections, ignoring headings in fences."""
+    raw_sections: list[tuple[str, tuple[str, ...], list[str]]] = []
+    stack: list[str] = []
+    current_heading = fallback_heading
+    current_path: tuple[str, ...] = ()
+    current_lines: list[str] = []
+    in_fence = False
+    fence_char = ""
+    fence_len = 0
+    has_heading = False
+
+    for line in markdown.splitlines():
+        stripped = line.lstrip()
+        fence = stripped.startswith("```") or stripped.startswith("~~~")
+        if fence:
+            marker = stripped[0]
+            length = len(stripped) - len(stripped.lstrip(marker))
+            if not in_fence:
+                in_fence, fence_char, fence_len = True, marker, length
+            elif marker == fence_char and length >= fence_len:
+                in_fence = False
+            current_lines.append(line)
+            continue
+        parsed = None if in_fence else _heading_level(line)
+        if parsed is not None:
+            level, heading = parsed
+            if not has_heading and current_lines:
+                raw_sections.append((fallback_heading, (), current_lines))
+            elif has_heading:
+                raw_sections.append((current_heading, current_path, current_lines))
+            current_lines = []
+            stack = stack[: level - 1]
+            stack.append(heading)
+            current_heading, current_path = heading, tuple(stack)
+            has_heading = True
+        else:
+            current_lines.append(line)
+    if current_lines:
+        raw_sections.append(
+            (
+                current_heading if has_heading else fallback_heading,
+                current_path if has_heading else (),
+                current_lines,
+            )
+        )
+
+    result: list[AuthoredSection] = []
+    table_number = 1
+    for heading, path, lines in raw_sections:
+        blocks, table_number = _split_blocks(lines, table_number)
+        if blocks:
+            result.append(AuthoredSection(heading, path, len(result), blocks))
+    return result
