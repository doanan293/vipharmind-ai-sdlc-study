@@ -0,0 +1,141 @@
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BundleCollection,
+    DocumentKind,
+    GlossaryEntry,
+    SourceInfo,
+)
+
+
+def test_split_markdown_handles_fallback_nested_headings_and_fences() -> None:
+    markdown = """Preamble text.
+
+# Usage
+
+Before fence.
+
+```md
+## Not a heading
+```
+
+## Dose
+
+Take one.
+
+### Adults
+
+Take two.
+
+## Empty
+
+# End
+"""
+    sections = split_markdown(markdown, fallback_heading="Body")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Body", (), 0),
+        ("Usage", ("Usage",), 1),
+        ("Dose", ("Usage", "Dose"), 2),
+        ("Adults", ("Usage", "Dose", "Adults"), 3),
+    ]
+    assert sections[0].blocks[0].markdown == "Preamble text."
+    assert sections[1].blocks[0].markdown.startswith("Before fence.")
+
+
+def test_split_markdown_groups_tables_and_prose_with_document_wide_keys() -> None:
+    markdown = """# First
+Intro
+| A | B |
+| --- | --- |
+After
+| C | D |
+
+# Second
+| E | F |
+| --- | --- |
+"""
+    sections = split_markdown(markdown, fallback_heading="Body")
+
+    assert [b.kind for b in sections[0].blocks] == [
+        BlockKind.PROSE,
+        BlockKind.TABLE,
+        BlockKind.PROSE,
+        BlockKind.TABLE,
+    ]
+    assert [
+        b.table_key for s in sections for b in s.blocks if b.kind == BlockKind.TABLE
+    ] == ["t1", "t2", "t3"]
+    assert [b.markdown for b in sections[0].blocks] == [
+        "Intro",
+        "| A | B |\n| --- | --- |",
+        "After",
+        "| C | D |",
+    ]
+
+
+def _doc(key: str, title: str, markdown: str) -> AuthoredDocument:
+    return AuthoredDocument(
+        key=key,
+        kind=DocumentKind.LEAFLET,
+        title=title,
+        source=SourceInfo(title=title),
+        markdown=markdown,
+    )
+
+
+def test_slug_and_section_key_are_ascii_bounded_and_collection_scoped() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("Một # tiêu đề / khác", max_length=11) == "mot-tieu-de"
+    assert section_key("c:d", ()) == "c:d#body"
+    assert section_key("c:d", ("Đường uống", "Liều dùng")) == "c:d#duong-uong/lieu-dung"
+
+
+def test_section_choices_follow_document_and_heading_reading_order() -> None:
+    collection = BundleCollection(key="med", title="Medicines")
+    docs = [
+        _doc("b", "Beta", "# Overview\nText\n## Dose\nDose text"),
+        _doc("a", "Alpha", "Body"),
+    ]
+    assert section_choices(collection, docs) == [
+        ("med:b#overview", "Beta › Overview"),
+        ("med:b#overview/dose", "Beta › Overview › Dose"),
+        ("med:a#body", "Alpha"),
+    ]
+
+
+def test_build_bundle_qualifies_keys_sorts_documents_and_filters_mappings() -> None:
+    from pharma_agent.domain.corpus.authoring import build_bundle
+    from pharma_agent.domain.corpus.bundle import ColloquialMappingRecord
+    from pharma_agent.domain.corpus.models import bundle_digest
+
+    collection = BundleCollection(key="med", title="Medicines")
+    docs = [_doc("z", "Zulu", "# Dose\nTake one."), _doc("a", "Alpha", "Body text")]
+    glossary = [GlossaryEntry(term="paracetamol")]
+    mappings = [
+        ColloquialMappingRecord(
+            key="p", aliases=["Para"], section_keys=["med:z#dose", "missing"]
+        )
+    ]
+    bundle = build_bundle(collection, docs, glossary, mappings)
+    assert [d.key for d in bundle.documents] == ["med:a", "med:z"]
+    assert [(s.key, s.document_key, s.context_path) for s in bundle.sections] == [
+        ("med:a#body", "med:a", []),
+        ("med:z#dose", "med:z", ["Dose"]),
+    ]
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == ["med:z#dose"]
+    assert (bundle.manifest.collection.key, bundle.manifest.collection.title) == (
+        "med",
+        "Medicines",
+    )
+    assert (bundle.manifest.document_count, bundle.manifest.section_count) == (2, 2)
+    assert bundle_digest(bundle) == bundle_digest(
+        build_bundle(collection, docs, glossary, mappings)
+    )
