+"""Turn human-authored Markdown into the existing knowledge bundle records."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from typing import Sequence
+
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind, BlockRecord, BundleCollection, BundleFile, BundleGenerator,
+    BundleManifest, ColloquialMappingRecord, DocumentKind, DocumentRecord,
+    GlossaryEntry, KnowledgeBundle, SectionRecord, SourceInfo,
+)
+
+_HEADING = re.compile(r"^\s{0,3}(#{1,6})\s+(.+?)\s*#*\s*$")
+_FENCE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
+
+
+@dataclass(frozen=True)
+class AuthoredSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    document: DocumentRecord
+    markdown: str
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[AuthoredSection]:
+    raw: list[tuple[str, tuple[str, ...], list[str]]] = []
+    stack: list[tuple[int, str]] = []
+    heading = fallback_heading
+    path: tuple[str, ...] = ()
+    lines: list[str] = []
+    fenced: tuple[str, int] | None = None
+    for line in markdown.splitlines():
+        fence = _FENCE.match(line)
+        if fenced:
+            lines.append(line)
+            if fence and fence.group(1)[0] == fenced[0] and len(fence.group(1)) >= fenced[1]:
+                fenced = None
+            continue
+        if fence:
+            fenced = (fence.group(1)[0], len(fence.group(1)))
+            lines.append(line)
+            continue
+        match = _HEADING.match(line)
+        if match:
+            if lines:
+                raw.append((heading, path, lines))
+            level, title = len(match.group(1)), match.group(2).strip()
+            stack = [(depth, name) for depth, name in stack if depth < level]
+            stack.append((level, title))
+            path = tuple(name for _, name in stack)
+            heading = title
+            lines = []
+        else:
+            lines.append(line)
+    if lines:
+        raw.append((heading, path, lines))
+
+    result: list[AuthoredSection] = []
+    table_number = 0
+    for title, section_path, section_lines in raw:
+        blocks: list[BlockRecord] = []
+        prose: list[str] = []
+        table: list[str] = []
+        def flush_prose() -> None:
+            content = "\n".join(prose).strip()
+            if content:
+                blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=content))
+            prose.clear()
+        def flush_table() -> None:
+            nonlocal table_number
+            content = "\n".join(table).strip()
+            if content:
+                table_number += 1
+                blocks.append(BlockRecord(kind=BlockKind.TABLE, markdown=content, table_key=f"t{table_number}"))
+            table.clear()
+        for line in section_lines:
+            if line.lstrip().startswith("|"):
+                flush_prose()
+                table.append(line.strip())
+            else:
+                flush_table()
+                prose.append(line)
+        flush_table()
+        flush_prose()
+        if blocks:
+            result.append(AuthoredSection(title, section_path, len(result) + 1, blocks))
+    return result
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    decomposed = unicodedata.normalize("NFKD", text.replace("Đ", "D").replace("đ", "d"))
+    ascii_text = decomposed.encode("ascii", "ignore").decode("ascii").lower()
+    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
+    if max_length <= 0:
+        return ""
+    slug = slug[:max_length].rstrip("-")
+    return slug
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    parts = [slugify(part) for part in path]
+    parts = [part for part in parts if part]
+    return f"{document_key}#{'/'.join(parts) if parts else 'body'}"
+
+
+def _document_key(collection: BundleCollection, document: AuthoredDocument) -> str:
+    return f"{collection.key}:{document.document.key}"
+
+
+def _sections_for(collection: BundleCollection, authored: AuthoredDocument) -> list[SectionRecord]:
+    key = _document_key(collection, authored)
+    return [SectionRecord(key=section_key(key, section.path), document_key=key,
+                          heading=section.heading, context_path=list(section.path),
+                          ordinal=section.ordinal, blocks=section.blocks)
+            for section in split_markdown(authored.markdown, fallback_heading="Body")]
+
+
+def section_choices(collection: BundleCollection, documents: Sequence[AuthoredDocument]) -> list[tuple[str, str]]:
+    choices = []
+    for authored in documents:
+        title = authored.document.title
+        for section in split_markdown(authored.markdown, fallback_heading="Body"):
+            choices.append((section_key(_document_key(collection, authored), section.path),
+                            " › ".join([title, *section.path])))
+    return choices
+
+
+def build_bundle(collection: BundleCollection, documents: Sequence[AuthoredDocument],
+                 glossary: list[GlossaryEntry], colloquial: list[ColloquialMappingRecord]) -> KnowledgeBundle:
+    ordered = sorted(documents, key=lambda item: item.document.key)
+    records = [item.document.model_copy(update={"key": _document_key(collection, item)}) for item in ordered]
+    sections = [section for item in ordered for section in _sections_for(collection, item)]
+    valid = {section.key for section in sections}
+    mappings = [mapping.model_copy(update={"section_keys": [key for key in mapping.section_keys if key in valid]})
+                for mapping in colloquial]
+    manifest = BundleManifest(
+        schema_version="knowledge-bundle/v1", collection=collection,
+        generator=BundleGenerator(name="pharma-agent-authoring", version="1", build_id="authored"),
+        source_digests={}, document_count=len(records), section_count=len(sections), files={},
+    )
+    return KnowledgeBundle(manifest=manifest, documents=records, sections=sections,
+                           glossary=list(glossary), colloquial_mappings=mappings)
diff --git a/backend/tests/domain/corpus/test_authoring.py b/backend/tests/domain/corpus/test_authoring.py
