@@ -0,0 +1,71 @@
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BundleCollection, ColloquialMappingRecord, DocumentKind, DocumentRecord,
+    GlossaryEntry, SourceInfo, BlockKind,
+)
+
+
+def test_split_markdown_headings_fences_fallback_tables_and_ordinals():
+    sections = split_markdown(
+        "intro\n\n| A | B |\n|---|---|\n| x | y |\n\n## Parent\nbody\n"
+        "### Child\n| C |\n|---|\n\n```md\n# not heading\n```\n## Empty\n",
+        fallback_heading="Body",
+    )
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Body", (), 1), ("Parent", ("Parent",), 2), ("Child", ("Parent", "Child"), 3)
+    ]
+    assert [b.kind for b in sections[0].blocks] == [BlockKind.PROSE, BlockKind.TABLE]
+    assert sections[0].blocks[1].table_key == "t1"
+    assert next(b for b in sections[2].blocks if b.kind is BlockKind.TABLE).table_key == "t2"
+    assert "# not heading" in sections[2].blocks[-1].markdown
+
+
+def test_slug_and_section_key():
+    assert slugify("Đường uống / Liều 2") == "duong-uong-lieu-2"
+    assert slugify("A very long title", max_length=8) == "a-very-l"
+    assert section_key("collection:doc", ()) == "collection:doc#body"
+    assert section_key("collection:doc", ("Đường uống", "Liều dùng")) == "collection:doc#duong-uong/lieu-dung"
+
+
+def test_build_bundle_qualifies_sorts_and_prunes_mappings():
+    collection = BundleCollection(key="c", title="Collection")
+    docs = [
+        AuthoredDocument(
+            document=DocumentRecord(key="z", kind=DocumentKind.LEAFLET, title="Zed", source=SourceInfo(title="S")),
+            markdown="# Use\nTake it.",
+        ),
+        AuthoredDocument(
+            document=DocumentRecord(key="a", kind=DocumentKind.LEAFLET, title="Alpha", source=SourceInfo(title="S")),
+            markdown="Plain text",
+        ),
+    ]
+    mappings = [ColloquialMappingRecord(key="m", section_keys=["c:z#use", "missing"])]
+    bundle = build_bundle(collection, docs, [GlossaryEntry(term="term")], mappings)
+    assert [d.key for d in bundle.documents] == ["c:a", "c:z"]
+    assert [s.key for s in bundle.sections] == ["c:a#body", "c:z#use"]
+    assert bundle.colloquial_mappings[0].section_keys == ["c:z#use"]
+    assert bundle.manifest.collection == collection
+    assert (bundle.manifest.document_count, bundle.manifest.section_count) == (2, 2)
+    assert section_choices(collection, docs) == [("c:z#use", "Zed › Use"), ("c:a#body", "Alpha")]
+
+
+def test_bundle_write_is_deterministic(tmp_path):
+    from pharma_agent.domain.corpus.bundle import write_bundle
+
+    collection = BundleCollection(key="c", title="Collection")
+    document = AuthoredDocument(
+        document=DocumentRecord(key="a", kind=DocumentKind.LEAFLET, title="Alpha", source=SourceInfo(title="S")),
+        markdown="# Use\nTake it.",
+    )
+    first = build_bundle(collection, [document], [], [])
+    second = build_bundle(collection, [document], [], [])
+    manifest_a = write_bundle(first, tmp_path / "a")
+    manifest_b = write_bundle(second, tmp_path / "b")
+    assert manifest_a.model_dump(mode="json") == manifest_b.model_dump(mode="json")
