@@ -0,0 +1,168 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    ColloquialMappingRecord,
+    DocumentKind,
+    GlossaryEntry,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import Collection, build_snapshot, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+
+NOW = datetime(2026, 10, 11, tzinfo=UTC)
+COLLECTION = Collection(id=uuid.uuid4(), key="notes", title="Ghi chú")
+
+MARKDOWN = """Lời mở đầu.
+
+# Paracetamol
+
+## Liều dùng
+Người lớn: 500 mg.
+
+| Tuổi | Liều |
+| --- | --- |
+| > 12 | 500 mg |
+Sau bảng.
+| a | b |
+
+```
+# không phải tiêu đề
+| không phải bảng |
+```
+
+## Đường uống
+
+### Chú ý
+Uống nhiều nước.
+
+# Trống
+"""
+
+
+def document(key: str, title: str, markdown: str) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid4(),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.GENERAL_MONOGRAPH,
+        source_title="Tự soạn",
+        source_url=None,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=NOW,
+        updated_by=None,
+        updated_at=NOW,
+    )
+
+
+def test_split_markdown_sections_paths_and_blocks() -> None:
+    sections = split_markdown(MARKDOWN, fallback_heading="Mở đầu")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Mở đầu", (), 1),
+        ("Liều dùng", ("Paracetamol", "Liều dùng"), 2),
+        ("Chú ý", ("Paracetamol", "Đường uống", "Chú ý"), 3),
+    ]
+    dose = sections[1].blocks
+    assert [(b.kind, b.table_key) for b in dose] == [
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t1"),
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t2"),
+        (BlockKind.PROSE, None),
+    ]
+    assert dose[0].markdown == "Người lớn: 500 mg."
+    assert dose[1].markdown.splitlines()[2] == "| > 12 | 500 mg |"
+    assert dose[2].markdown == "Sau bảng."
+    assert dose[4].markdown.startswith("```\n# không phải tiêu đề\n| không phải bảng |")
+
+
+def test_document_without_headings_is_one_fallback_section() -> None:
+    sections = split_markdown("Chỉ có văn bản.", fallback_heading="Ghi chú")
+
+    assert [(s.heading, s.path) for s in sections] == [("Ghi chú", ())]
+    assert split_markdown("  \n\n", fallback_heading="x") == []
+
+
+def test_slugify_and_section_key() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Liều dùng / Trẻ em (< 12 tuổi)!  ") == "lieu-dung-tre-em-12-tuoi"
+    assert slugify("a " * 100, max_length=5) == "a-a-a"
+    assert section_key("notes:para", ()) == "notes:para#body"
+    assert section_key("notes:para", ("Paracetamol", "Đường uống")) == (
+        "notes:para#paracetamol/duong-uong"
+    )
+
+
+def test_section_choices_label_title_and_path() -> None:
+    docs = [document("para", "Paracetamol", MARKDOWN)]
+
+    assert section_choices(COLLECTION, docs) == [
+        ("notes:para#body", "Paracetamol"),
+        ("notes:para#paracetamol/lieu-dung", "Paracetamol › Paracetamol › Liều dùng"),
+        (
+            "notes:para#paracetamol/duong-uong/chu-y",
+            "Paracetamol › Paracetamol › Đường uống › Chú ý",
+        ),
+    ]
+
+
+def test_repeated_heading_paths_get_unique_keys() -> None:
+    docs = [document("d", "D", "# A\nx\n# A\ny")]
+
+    assert [key for key, _ in section_choices(COLLECTION, docs)] == [
+        "notes:d#a",
+        "notes:d#a-2",
+    ]
+
+
+def test_build_bundle_is_valid_and_deterministic(tmp_path: Path) -> None:
+    docs = [
+        document("zeta", "Zeta", "Nội dung zeta."),
+        document("para", "Paracetamol", MARKDOWN),
+    ]
+    glossary = [GlossaryEntry(term="ADR")]
+    colloquial = [
+        ColloquialMappingRecord(
+            key="hapacol",
+            aliases=["thuốc hạ sốt"],
+            section_keys=["notes:para#paracetamol/lieu-dung", "notes:gone#body"],
+        )
+    ]
+
+    bundle = build_bundle(COLLECTION, docs, glossary, colloquial)
+
+    assert [d.key for d in bundle.documents] == ["notes:para", "notes:zeta"]
+    assert [s.key for s in bundle.sections] == [
+        "notes:para#body",
+        "notes:para#paracetamol/lieu-dung",
+        "notes:para#paracetamol/duong-uong/chu-y",
+        "notes:zeta#body",
+    ]
+    assert bundle.sections[-1].heading == "Zeta"
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == [
+        "notes:para#paracetamol/lieu-dung"
+    ]
+    manifest = bundle.manifest
+    assert (manifest.collection.key, manifest.collection.title) == ("notes", "Ghi chú")
+    assert (manifest.document_count, manifest.section_count) == (2, 4)
+
+    again = build_bundle(COLLECTION, list(reversed(docs)), glossary, colloquial)
+    assert again == bundle
+    assert bundle_digest(again) == bundle_digest(bundle)
+
+    write_bundle(bundle, tmp_path)
+    assert build_snapshot(bundle).collection.key == "notes"
