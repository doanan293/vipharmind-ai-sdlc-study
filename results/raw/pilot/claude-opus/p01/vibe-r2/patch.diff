@@ -0,0 +1,156 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    ColloquialMappingRecord,
+    DocumentKind,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import Collection, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+
+AT = datetime(2026, 1, 1, tzinfo=UTC)
+COLLECTION = Collection(id=uuid.uuid4(), key="notes", title="Ghi chú")
+
+
+def _document(key: str, title: str, markdown: str) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid4(),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.GENERAL_MONOGRAPH,
+        source_title="Nội bộ",
+        source_url=None,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=AT,
+        updated_by=None,
+        updated_at=AT,
+    )
+
+
+MARKDOWN = """Lời mở đầu.
+
+# Paracetamol
+
+## Liều dùng
+
+Người lớn 500 mg.
+
+| Tuổi | Liều |
+| --- | --- |
+| > 12 | 500 mg |
+
+Không quá 4 g.
+
+```
+# not a heading
+```
+
+## Tương tác
+
+| Thuốc | Hậu quả |
+| --- | --- |
+| Warfarin | Tăng INR |
+
+# Trống
+"""
+
+
+def test_split_markdown_sections_paths_and_blocks() -> None:
+    sections = split_markdown(MARKDOWN, fallback_heading="Tiêu đề")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Tiêu đề", (), 1),
+        ("Liều dùng", ("Paracetamol", "Liều dùng"), 2),
+        ("Tương tác", ("Paracetamol", "Tương tác"), 3),
+    ]
+    dose = sections[1].blocks
+    assert [b.kind for b in dose] == [
+        BlockKind.PROSE,
+        BlockKind.TABLE,
+        BlockKind.PROSE,
+    ]
+    assert dose[0].markdown == "Người lớn 500 mg."
+    assert dose[1].table_key == "t1"
+    assert dose[1].markdown.splitlines()[2] == "| > 12 | 500 mg |"
+    assert "# not a heading" in dose[2].markdown
+    assert sections[2].blocks[0].table_key == "t2"
+
+
+def test_split_markdown_without_headings() -> None:
+    sections = split_markdown("  chỉ có chữ  \n", fallback_heading="Tài liệu")
+
+    assert len(sections) == 1
+    assert (sections[0].heading, sections[0].path) == ("Tài liệu", ())
+    assert sections[0].blocks[0].markdown == "chỉ có chữ"
+
+
+def test_slugify_and_section_key() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("Liều  dùng (người lớn)!") == "lieu-dung-nguoi-lon"
+    assert len(slugify("tương tác " * 40)) <= 80
+    assert slugify("abc def", max_length=5) == "abc"
+    assert section_key("notes:a", ()) == "notes:a#body"
+    assert section_key("notes:a", ("Paracetamol", "Liều dùng")) == (
+        "notes:a#paracetamol/lieu-dung"
+    )
+
+
+def test_section_choices_in_reading_order() -> None:
+    documents = [_document("b", "Thuốc B", MARKDOWN), _document("a", "A", "# X\nx")]
+
+    choices = section_choices(COLLECTION, documents)
+
+    assert choices[:2] == [
+        ("notes:b#body", "Thuốc B"),
+        ("notes:b#paracetamol/lieu-dung", "Thuốc B › Paracetamol › Liều dùng"),
+    ]
+    assert choices[-1] == ("notes:a#x", "A › X")
+
+
+def test_build_bundle_is_deterministic_and_valid(tmp_path: Path) -> None:
+    documents = [
+        _document("b", "Thuốc B", MARKDOWN),
+        _document("a", "A", "# X\nx\n# X\ny"),
+    ]
+    glossary = [GlossaryEntry(term="INR")]
+    colloquial = [
+        ColloquialMappingRecord(
+            key="hapacol",
+            aliases=["thuốc hạ sốt"],
+            section_keys=["notes:b#paracetamol/lieu-dung", "notes:b#missing"],
+        ),
+        ColloquialMappingRecord(key="gone", section_keys=["notes:z#body"]),
+    ]
+
+    bundle = build_bundle(COLLECTION, documents, glossary, colloquial)
+    again = build_bundle(COLLECTION, list(reversed(documents)), glossary, colloquial)
+
+    assert [d.key for d in bundle.documents] == ["notes:a", "notes:b"]
+    assert [s.key for s in bundle.sections[:2]] == ["notes:a#x", "notes:a#x-2"]
+    assert bundle.glossary == glossary
+    assert [m.section_keys for m in bundle.colloquial_mappings] == [
+        ["notes:b#paracetamol/lieu-dung"]
+    ]
+    manifest = bundle.manifest
+    assert (manifest.collection.key, manifest.collection.title) == ("notes", "Ghi chú")
+    assert (manifest.document_count, manifest.section_count) == (2, 5)
+    assert bundle_digest(bundle) == bundle_digest(again)
+    assert bundle == again
+
+    write_bundle(bundle, tmp_path)
+    assert read_bundle(tmp_path).sections == bundle.sections
