+"""Turn authored Markdown documents into a knowledge bundle (spec §4.7).
+
+Publishing a collection builds a ``KnowledgeBundle`` here and hands it to the same
+import the CLI uses. Everything is deterministic: the same documents, glossary and
+colloquial mappings always give the same bundle and therefore the same bundle digest.
+"""
+
+import re
+import unicodedata
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+from pharma_agent.domain.corpus.identity import canonical_json, sha256_hex
+from pharma_agent.domain.corpus.models import Collection
+from pharma_agent.domain.corpus.source import SourceDocument
+
+GENERATOR_NAME = "pharma-agent-authoring"
+GENERATOR_VERSION = "1"
+BODY_SECTION = "body"
+LABEL_SEPARATOR = " › "
+
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_NON_ALNUM_RE = re.compile(r"[^a-z0-9]+")
+_LETTER_FOLDS = str.maketrans({"đ": "d", "Đ": "D", "ð": "d", "Ð": "D"})
+
+
+@dataclass(frozen=True)
+class MarkdownSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: tuple[BlockRecord, ...]
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Lowercase ASCII words joined by hyphens; Vietnamese marks are removed."""
+    decomposed = unicodedata.normalize("NFKD", text.translate(_LETTER_FOLDS))
+    ascii_text = "".join(
+        char for char in decomposed if not unicodedata.combining(char)
+    ).lower()
+    slug = _NON_ALNUM_RE.sub("-", ascii_text).strip("-")
+    if len(slug) > max_length:
+        head = slug[:max_length]
+        if slug[max_length] != "-" and "-" in head:
+            # The cut falls inside a word: drop that partial word.
+            head = head.rsplit("-", 1)[0]
+        slug = head.strip("-")
+    return slug
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    if not path:
+        return f"{document_key}#{BODY_SECTION}"
+    return f"{document_key}#" + "/".join(slugify(part) or "section" for part in path)
+
+
+def bundle_document_key(collection_key: str, document_key: str) -> str:
+    """Document keys carry the collection key so chunk ids never collide."""
+    return f"{collection_key}:{document_key}"
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[MarkdownSection]:
+    """Split on ATX headings outside fenced code; empty sections are dropped.
+
+    Text before the first heading, or a document without headings, becomes a section
+    titled `fallback_heading` with an empty path. Table keys ``t1``, ``t2``… are
+    numbered across the whole document.
+    """
+    lines = unicodedata.normalize("NFC", markdown)
+    lines = lines.replace("\r\n", "\n").replace("\r", "\n")
+
+    raw: list[tuple[str, tuple[str, ...], list[str]]] = [(fallback_heading, (), [])]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in lines.split("\n"):
+        fence_match = _FENCE_RE.match(line)
+        if fence is not None:
+            if (
+                fence_match
+                and fence_match.group(1)[0] == fence[0]
+                and len(fence_match.group(1)) >= len(fence)
+            ):
+                fence = None
+            raw[-1][2].append(line)
+            continue
+        if fence_match:
+            fence = fence_match.group(1)
+            raw[-1][2].append(line)
+            continue
+        heading_match = _HEADING_RE.match(line)
+        if heading_match:
+            level = len(heading_match.group(1))
+            heading = (heading_match.group(2) or "").strip()
+            if heading:
+                while stack and stack[-1][0] >= level:
+                    stack.pop()
+                stack.append((level, heading))
+                raw.append((heading, tuple(text for _, text in stack), []))
+                continue
+        raw[-1][2].append(line)
+
+    sections: list[MarkdownSection] = []
+    tables = 0
+    for heading, path, body in raw:
+        blocks, tables = _blocks(body, tables)
+        if blocks:
+            sections.append(
+                MarkdownSection(
+                    heading=heading,
+                    path=path,
+                    ordinal=len(sections) + 1,
+                    blocks=tuple(blocks),
+                )
+            )
+    return sections
+
+
+def _blocks(lines: list[str], tables: int) -> tuple[list[BlockRecord], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    table: list[str] = []
+    fence: str | None = None
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        prose.clear()
+
+    def flush_table() -> None:
+        nonlocal tables
+        if table:
+            tables += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(table),
+                    table_key=f"t{tables}",
+                )
+            )
+        table.clear()
+
+    for line in lines:
+        fence_match = _FENCE_RE.match(line)
+        if fence is None and fence_match:
+            fence = fence_match.group(1)
+        elif (
+            fence is not None
+            and fence_match
+            and fence_match.group(1)[0] == fence[0]
+            and len(fence_match.group(1)) >= len(fence)
+        ):
+            fence = None
+        elif fence is None and line.lstrip().startswith("|"):
+            flush_prose()
+            table.append(line.strip())
+            continue
+        flush_table()
+        prose.append(line.rstrip())
+    flush_table()
+    flush_prose()
+    return blocks, tables
+
+
+@dataclass(frozen=True)
+class _KeyedSection:
+    key: str
+    section: MarkdownSection
+
+
+def _document_sections(
+    collection_key: str, document: SourceDocument
+) -> list[_KeyedSection]:
+    """Sections of `document` with unique keys; repeated paths get ``-2``, ``-3``…"""
+    document_key = bundle_document_key(collection_key, document.key)
+    keyed: list[_KeyedSection] = []
+    seen: set[str] = set()
+    for section in split_markdown(document.markdown, fallback_heading=document.title):
+        base = section_key(document_key, section.path)
+        key, counter = base, 1
+        while key in seen:
+            counter += 1
+            key = f"{base}-{counter}"
+        seen.add(key)
+        keyed.append(_KeyedSection(key=key, section=section))
+    return keyed
+
+
+def section_choices(
+    collection: Collection, documents: Iterable[SourceDocument]
+) -> list[tuple[str, str]]:
+    """``(section key, label)`` pairs in reading order, for picking mapped sections."""
+    choices: list[tuple[str, str]] = []
+    for document in documents:
+        for keyed in _document_sections(collection.key, document):
+            label = LABEL_SEPARATOR.join((document.title, *keyed.section.path))
+            choices.append((keyed.key, label))
+    return choices
+
+
+def build_bundle(
+    collection: Collection,
+    documents: Iterable[SourceDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    """A bundle of the authored content, deterministic for the same input.
+
+    Colloquial section keys that name no section are removed, as are keys an earlier
+    mapping already claims; a mapping left without sections is dropped.
+    """
+    ordered = sorted(documents, key=lambda document: document.key)
+    document_records: list[DocumentRecord] = []
+    section_records: list[SectionRecord] = []
+    source_digests: dict[str, str] = {}
+    for document in ordered:
+        document_key = bundle_document_key(collection.key, document.key)
+        document_records.append(
+            DocumentRecord(
+                key=document_key,
+                kind=document.kind,
+                title=document.title,
+                source=SourceInfo(title=document.source_title, url=document.source_url),
+            )
+        )
+        source_digests[document_key] = sha256_hex(document.markdown)
+        for keyed in _document_sections(collection.key, document):
+            section = keyed.section
+            section_records.append(
+                SectionRecord(
+                    key=keyed.key,
+                    document_key=document_key,
+                    heading=section.heading,
+                    context_path=list(section.path),
+                    ordinal=section.ordinal,
+                    blocks=list(section.blocks),
+                )
+            )
+
+    known = {record.key for record in section_records}
+    claimed: set[str] = set()
+    mappings: list[ColloquialMappingRecord] = []
+    for mapping in colloquial:
+        keys: list[str] = []
+        for key in mapping.section_keys:
+            if key in known and key not in claimed:
+                claimed.add(key)
+                keys.append(key)
+        if keys:
+            mappings.append(mapping.model_copy(update={"section_keys": keys}))
+
+    content_digest = sha256_hex(
+        canonical_json(
+            {
+                "documents": [r.model_dump(mode="json") for r in document_records],
+                "sections": [r.model_dump(mode="json") for r in section_records],
+                "glossary": [e.model_dump(mode="json") for e in glossary],
+                "colloquial_mappings": [m.model_dump(mode="json") for m in mappings],
+            }
+        )
+    )
+    manifest = BundleManifest(
+        schema_version="knowledge-bundle/v1",
+        collection=BundleCollection(key=collection.key, title=collection.title),
+        generator=BundleGenerator(
+            name=GENERATOR_NAME, version=GENERATOR_VERSION, build_id=content_digest
+        ),
+        source_digests=source_digests,
+        document_count=len(document_records),
+        section_count=len(section_records),
+        files={},
+    )
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=document_records,
+        sections=section_records,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
