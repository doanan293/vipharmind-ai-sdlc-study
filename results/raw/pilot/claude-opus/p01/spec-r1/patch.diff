@@ -0,0 +1,289 @@
+"""Knowledge bundles from authored Markdown documents (spec §5).
+
+Framework-free and deterministic: the same documents, glossary and colloquial names
+always give the same ``KnowledgeBundle`` and so the same bundle digest. Publishing feeds
+the result to the same import as bundles built by pharma-lab.
+"""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+from pharma_agent.domain.corpus.models import Collection, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+from pharma_agent.domain.shared.text import normalize_text
+
+GENERATOR_NAME = "pharma-agent-authoring"
+GENERATOR_VERSION = "1"
+LABEL_SEPARATOR = " › "
+
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_NON_SLUG_RE = re.compile(r"[^a-z0-9]+")
+_EMPTY_PART_SLUG = "section"
+_BODY_SLUG = "body"
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Lowercase ASCII words joined by hyphens; Vietnamese marks are removed."""
+    decomposed = unicodedata.normalize("NFKD", text.replace("đ", "d").replace("Đ", "D"))
+    ascii_text = decomposed.encode("ascii", "ignore").decode("ascii").lower()
+    slug = _NON_SLUG_RE.sub("-", ascii_text).strip("-")
+    return slug[:max_length].strip("-")
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    """``<document_key>#<slug>/<slug>``, or ``<document_key>#body`` for an empty path."""
+    if not path:
+        return f"{document_key}#{_BODY_SLUG}"
+    parts = (slugify(part) or _EMPTY_PART_SLUG for part in path)
+    return f"{document_key}#{'/'.join(parts)}"
+
+
+def bundle_document_key(collection_key: str, document_key: str) -> str:
+    """Bundle keys carry the collection so chunk ids never collide across collections."""
+    return f"{collection_key}:{document_key}"
+
+
+@dataclass(frozen=True)
+class MarkdownSection:
+    """One section of an authored document.
+
+    ``path`` is the trail of headings down to and including ``heading``; it is empty for
+    the fallback section that holds text before the first heading.
+    """
+
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: tuple[BlockRecord, ...]
+
+
+@dataclass
+class _Draft:
+    heading: str
+    path: tuple[str, ...]
+    lines: list[tuple[str, bool]]  # (line, inside fenced code)
+
+
+class _Fence:
+    """Tracks fenced code blocks opened by ``` or ~~~ (three or more)."""
+
+    def __init__(self) -> None:
+        self._marker: str | None = None
+
+    @property
+    def open(self) -> bool:
+        return self._marker is not None
+
+    def feed(self, line: str) -> bool:
+        """Advance over `line`; True when the line belongs to a fenced block."""
+        match = _FENCE_RE.match(line)
+        if self._marker is None:
+            if match:
+                self._marker = match.group(1)
+                return True
+            return False
+        if (
+            match
+            and match.group(1)[0] == self._marker[0]
+            and len(match.group(1)) >= len(self._marker)
+            and not line.strip().lstrip(self._marker[0])
+        ):
+            self._marker = None
+        return True
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[MarkdownSection]:
+    """Split authored Markdown into sections of prose and table blocks.
+
+    ATX headings outside fenced code start sections; text before the first heading is a
+    section titled `fallback_heading` with an empty path. Each run of lines starting with
+    ``|`` (outside fenced code) is a table block keyed ``t1``, ``t2``, … across the
+    document; the text between tables becomes stripped prose blocks. Sections without
+    content are dropped and ordinals count the kept sections from 1.
+    """
+    drafts = [_Draft(heading=fallback_heading, path=(), lines=[])]
+    stack: list[tuple[int, str]] = []
+    fence = _Fence()
+    for line in normalize_text(markdown).split("\n"):
+        if not fence.open:
+            heading = _HEADING_RE.match(line)
+            if heading and heading.group(2).strip():
+                level = len(heading.group(1))
+                while stack and stack[-1][0] >= level:
+                    stack.pop()
+                stack.append((level, heading.group(2).strip()))
+                path = tuple(text for _, text in stack)
+                drafts.append(_Draft(heading=path[-1], path=path, lines=[]))
+                continue
+        fenced = fence.feed(line)
+        drafts[-1].lines.append((line, fenced))
+
+    sections: list[MarkdownSection] = []
+    tables = 0
+    for draft in drafts:
+        blocks: list[BlockRecord] = []
+        for is_table, lines in _runs(draft.lines):
+            text = "\n".join(lines).strip()
+            if not text:
+                continue
+            if is_table:
+                tables += 1
+                blocks.append(
+                    BlockRecord(
+                        kind=BlockKind.TABLE, markdown=text, table_key=f"t{tables}"
+                    )
+                )
+            else:
+                blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        if blocks:
+            sections.append(
+                MarkdownSection(
+                    heading=draft.heading,
+                    path=draft.path,
+                    ordinal=len(sections) + 1,
+                    blocks=tuple(blocks),
+                )
+            )
+    return sections
+
+
+def _runs(lines: Sequence[tuple[str, bool]]) -> list[tuple[bool, list[str]]]:
+    """Group lines into alternating (is_table, lines) runs."""
+    runs: list[tuple[bool, list[str]]] = []
+    for line, fenced in lines:
+        is_table = not fenced and line.lstrip().startswith("|")
+        if runs and runs[-1][0] == is_table:
+            runs[-1][1].append(line)
+        else:
+            runs.append((is_table, [line]))
+    return runs
+
+
+def _keyed_sections(
+    collection: Collection, document: SourceDocument
+) -> tuple[str, list[tuple[str, MarkdownSection]]]:
+    """The bundle key of `document` and its sections with their section keys.
+
+    Sections sharing a heading path get ``-2``, ``-3``, … in reading order so every
+    key is unique within the bundle.
+    """
+    document_key = bundle_document_key(collection.key, document.key)
+    seen: set[str] = set()
+    keyed: list[tuple[str, MarkdownSection]] = []
+    for section in split_markdown(document.markdown, fallback_heading=document.title):
+        base = section_key(document_key, section.path)
+        key = base
+        suffix = 2
+        while key in seen:
+            key = f"{base}-{suffix}"
+            suffix += 1
+        seen.add(key)
+        keyed.append((key, section))
+    return document_key, keyed
+
+
+def section_choices(
+    collection: Collection, documents: Sequence[SourceDocument]
+) -> list[tuple[str, str]]:
+    """``(section key, label)`` pairs in reading order, documents in the given order.
+
+    The label is the document title followed by the heading path, joined by `` › ``.
+    """
+    return [
+        (key, LABEL_SEPARATOR.join((document.title, *section.path)))
+        for document in documents
+        for key, section in _keyed_sections(collection, document)[1]
+    ]
+
+
+def build_bundle(
+    collection: Collection,
+    documents: Sequence[SourceDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    """A ``knowledge-bundle/v1`` of the collection's authored content.
+
+    Documents are sorted by bundle key, each section becomes one section record, the
+    glossary is kept as given and colloquial mappings lose section keys that do not
+    exist. Nothing depends on time or randomness, so equal content gives an equal bundle.
+    """
+    keyed = sorted(
+        ((*_keyed_sections(collection, document), document) for document in documents),
+        key=lambda item: item[0],
+    )
+    document_records: list[DocumentRecord] = []
+    section_records: list[SectionRecord] = []
+    for document_key, sections, document in keyed:
+        document_records.append(
+            DocumentRecord(
+                key=document_key,
+                kind=document.kind,
+                title=document.title,
+                source=SourceInfo(title=document.source_title, url=document.source_url),
+            )
+        )
+        section_records.extend(
+            SectionRecord(
+                key=key,
+                document_key=document_key,
+                heading=section.heading,
+                context_path=list(section.path),
+                ordinal=section.ordinal,
+                blocks=list(section.blocks),
+            )
+            for key, section in sections
+        )
+
+    known = {record.key for record in section_records}
+    mappings = [
+        mapping.model_copy(
+            update={"section_keys": [k for k in mapping.section_keys if k in known]}
+        )
+        for mapping in colloquial
+    ]
+    content = KnowledgeBundle(
+        manifest=BundleManifest(
+            schema_version=BUNDLE_SCHEMA_VERSION,
+            collection=BundleCollection(key=collection.key, title=collection.title),
+            generator=BundleGenerator(
+                name=GENERATOR_NAME, version=GENERATOR_VERSION, build_id=""
+            ),
+            source_digests={},
+            document_count=len(document_records),
+            section_count=len(section_records),
+            files={},
+        ),
+        documents=document_records,
+        sections=section_records,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
+    # The manifest is excluded from the digest, so it can name the content it carries.
+    digest = bundle_digest(content)
+    manifest = content.manifest.model_copy(
+        update={
+            "generator": content.manifest.generator.model_copy(
+                update={"build_id": digest}
+            ),
+            "source_digests": {"authored_content_sha256": digest},
+        }
+    )
+    return content.model_copy(update={"manifest": manifest})
diff --git a/backend/tests/domain/corpus/test_authoring.py b/backend/tests/domain/corpus/test_authoring.py
