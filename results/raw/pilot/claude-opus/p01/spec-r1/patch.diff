@@ -0,0 +1,276 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BlockRecord,
+    ColloquialMappingRecord,
+    DocumentKind,
+    GlossaryEntry,
+    SourceInfo,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import (
+    Collection,
+    build_snapshot,
+    bundle_digest,
+    collection_id_for,
+)
+from pharma_agent.domain.corpus.source import SourceDocument
+
+
+def prose(text: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.PROSE, markdown=text)
+
+
+def table(text: str, key: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.TABLE, markdown=text, table_key=key)
+
+
+def test_slugify_strips_vietnamese_marks() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Liều lượng & cách dùng (người lớn)! ") == (
+        "lieu-luong-cach-dung-nguoi-lon"
+    )
+    assert slugify("ĐỘC TÍNH") == "doc-tinh"
+    assert slugify("!!!") == ""
+
+
+def test_slugify_respects_max_length() -> None:
+    slug = slugify("abc def ghi", max_length=4)
+    assert slug == "abc"
+    assert len(slugify("x" * 200)) == 80
+
+
+def test_section_key_joins_slugified_path() -> None:
+    assert section_key("c:d", ("Liều dùng", "Trẻ em")) == "c:d#lieu-dung/tre-em"
+    assert section_key("c:d", ()) == "c:d#body"
+    assert section_key("c:d", ("???",)) == "c:d#section"
+
+
+DOCUMENT = """Lời mở đầu.
+
+# Paracetamol
+
+Thuốc giảm đau.
+
+## Liều dùng
+
+### Người lớn
+
+Uống 500 mg.
+
+| Tuổi | Liều |
+| --- | --- |
+| > 12 | 500 mg |
+Ghi chú sau bảng.
+
+| a | b |
+
+### Trẻ em
+
+```
+# không phải tiêu đề
+| không phải bảng |
+```
+
+## Trống
+
+# Tương tác
+
+| Thuốc | Mức |
+"""
+
+
+def test_split_markdown_builds_paths_blocks_and_tables() -> None:
+    sections = split_markdown(DOCUMENT, fallback_heading="Paracetamol 500")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Paracetamol 500", (), 1),
+        ("Paracetamol", ("Paracetamol",), 2),
+        ("Người lớn", ("Paracetamol", "Liều dùng", "Người lớn"), 3),
+        ("Trẻ em", ("Paracetamol", "Liều dùng", "Trẻ em"), 4),
+        ("Tương tác", ("Tương tác",), 5),
+    ]
+    assert [list(s.blocks) for s in sections] == [
+        [prose("Lời mở đầu.")],
+        [prose("Thuốc giảm đau.")],
+        [
+            prose("Uống 500 mg."),
+            table("| Tuổi | Liều |\n| --- | --- |\n| > 12 | 500 mg |", "t1"),
+            prose("Ghi chú sau bảng."),
+            table("| a | b |", "t2"),
+        ],
+        [prose("```\n# không phải tiêu đề\n| không phải bảng |\n```")],
+        [table("| Thuốc | Mức |", "t3")],
+    ]
+
+
+def test_split_markdown_without_headings_uses_the_fallback() -> None:
+    sections = split_markdown("\n  Chỉ có nội dung.  \n", fallback_heading="Tờ HDSD")
+    assert len(sections) == 1
+    assert sections[0].heading == "Tờ HDSD"
+    assert sections[0].path == ()
+    assert sections[0].ordinal == 1
+    assert list(sections[0].blocks) == [prose("Chỉ có nội dung.")]
+
+
+def test_split_markdown_heading_syntax() -> None:
+    sections = split_markdown(
+        "#hashtag\n\n## Closed ##\ntext\n####### seven\n~~~\n# fenced\n~~~\n",
+        fallback_heading="F",
+    )
+    assert [(s.heading, s.path) for s in sections] == [
+        ("F", ()),
+        ("Closed", ("Closed",)),
+    ]
+    assert list(sections[1].blocks) == [
+        prose("text\n####### seven\n~~~\n# fenced\n~~~")
+    ]
+
+
+def test_split_markdown_drops_empty_documents() -> None:
+    assert split_markdown("# A\n\n## B\n", fallback_heading="F") == []
+    assert split_markdown("", fallback_heading="F") == []
+
+
+NOW = datetime(2026, 11, 15, tzinfo=UTC)
+COLLECTION = Collection(
+    id=collection_id_for("clinic"), key="clinic", title="Phòng khám"
+)
+
+
+def source_document(key: str, title: str, markdown: str) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid5(uuid.NAMESPACE_URL, key),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.LEAFLET,
+        source_title=f"Nguồn {title}",
+        source_url=None,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=NOW,
+        updated_by=None,
+        updated_at=NOW,
+    )
+
+
+SIROP = source_document(
+    "siro-ho",
+    "Siro ho",
+    "Mở đầu.\n\n# Công dụng\nGiảm ho.\n\n# Ghi chú\nMột.\n\n# Ghi chú\nHai.\n",
+)
+PARA = source_document("para", "Paracetamol", DOCUMENT)
+
+
+def test_section_choices_lists_sections_in_reading_order() -> None:
+    assert section_choices(COLLECTION, [SIROP, PARA]) == [
+        ("clinic:siro-ho#body", "Siro ho"),
+        ("clinic:siro-ho#cong-dung", "Siro ho › Công dụng"),
+        ("clinic:siro-ho#ghi-chu", "Siro ho › Ghi chú"),
+        ("clinic:siro-ho#ghi-chu-2", "Siro ho › Ghi chú"),
+        ("clinic:para#body", "Paracetamol"),
+        ("clinic:para#paracetamol", "Paracetamol › Paracetamol"),
+        (
+            "clinic:para#paracetamol/lieu-dung/nguoi-lon",
+            "Paracetamol › Paracetamol › Liều dùng › Người lớn",
+        ),
+        (
+            "clinic:para#paracetamol/lieu-dung/tre-em",
+            "Paracetamol › Paracetamol › Liều dùng › Trẻ em",
+        ),
+        ("clinic:para#tuong-tac", "Paracetamol › Tương tác"),
+    ]
+
+
+GLOSSARY = [
+    GlossaryEntry(term="HDSD", vietnamese_expansions=["hướng dẫn sử dụng"]),
+    GlossaryEntry(term="ADR"),
+]
+COLLOQUIAL = [
+    ColloquialMappingRecord(
+        key="siro",
+        aliases=["siro ho bé"],
+        section_keys=["clinic:siro-ho#cong-dung", "clinic:siro-ho#missing"],
+    ),
+    ColloquialMappingRecord(key="old", section_keys=["other:doc#body"]),
+]
+
+
+def test_build_bundle_maps_documents_and_sections() -> None:
+    bundle = build_bundle(COLLECTION, [SIROP, PARA], GLOSSARY, COLLOQUIAL)
+
+    assert [d.key for d in bundle.documents] == ["clinic:para", "clinic:siro-ho"]
+    para = bundle.documents[0]
+    assert para.title == "Paracetamol"
+    assert para.kind is DocumentKind.LEAFLET
+    assert para.source == SourceInfo(title="Nguồn Paracetamol")
+
+    assert [s.key for s in bundle.sections] == [
+        key for key, _ in section_choices(COLLECTION, [PARA, SIROP])
+    ]
+    adults = next(s for s in bundle.sections if s.heading == "Người lớn")
+    assert adults.document_key == "clinic:para"
+    assert adults.context_path == ["Paracetamol", "Liều dùng", "Người lớn"]
+    assert adults.ordinal == 3
+    assert [b.table_key for b in adults.blocks] == [None, "t1", None, "t2"]
+    body = bundle.sections[0]
+    assert (body.key, body.heading, body.context_path) == (
+        "clinic:para#body",
+        "Paracetamol",
+        [],
+    )
+
+    assert bundle.glossary == GLOSSARY
+    assert bundle.colloquial_mappings == [
+        ColloquialMappingRecord(
+            key="siro",
+            aliases=["siro ho bé"],
+            section_keys=["clinic:siro-ho#cong-dung"],
+        ),
+        ColloquialMappingRecord(key="old", section_keys=[]),
+    ]
+
+    manifest = bundle.manifest
+    assert manifest.schema_version == "knowledge-bundle/v1"
+    assert (manifest.collection.key, manifest.collection.title) == (
+        "clinic",
+        "Phòng khám",
+    )
+    assert manifest.document_count == 2
+    assert manifest.section_count == len(bundle.sections) == 9
+
+
+def test_build_bundle_is_deterministic() -> None:
+    first = build_bundle(COLLECTION, [SIROP, PARA], GLOSSARY, COLLOQUIAL)
+    second = build_bundle(COLLECTION, [PARA, SIROP], GLOSSARY, COLLOQUIAL)
+    assert first == second
+    assert bundle_digest(first) == bundle_digest(second)
+
+    edited = source_document("para", "Paracetamol", DOCUMENT + "\nThêm.\n")
+    changed = build_bundle(COLLECTION, [SIROP, edited], GLOSSARY, COLLOQUIAL)
+    assert bundle_digest(changed) != bundle_digest(first)
+    assert changed.manifest.generator.build_id != first.manifest.generator.build_id
+
+
+def test_built_bundle_passes_bundle_validation_and_import(tmp_path: Path) -> None:
+    bundle = build_bundle(COLLECTION, [SIROP, PARA], GLOSSARY, COLLOQUIAL)
+    write_bundle(bundle, tmp_path)
+    read = read_bundle(tmp_path)
+    assert bundle_digest(read) == bundle_digest(bundle)
+
+    snapshot = build_snapshot(read)
+    assert snapshot.collection.key == "clinic"
+    assert len(snapshot.sections) == 9
