@@ -0,0 +1,311 @@
+"""Knowledge bundles built from authored Markdown documents (spec §4.7, §5).
+
+Publishing a collection turns its authored documents, glossary and colloquial names into
+a ``KnowledgeBundle`` that goes through the same import as a pharma-lab bundle. Every
+function is pure, so the same content always gives the same bundle digest.
+"""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Final
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+from pharma_agent.domain.corpus.models import Collection, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+
+_NON_SLUG_RE = re.compile(r"[^a-z0-9]+")
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*?))?[ \t]*$")
+_CLOSING_HASHES_RE = re.compile(r"(?:^|[ \t]+)#+$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_EMPTY_SLUG_PART = "section"
+_BODY_PART = "body"
+LABEL_SEPARATOR = " › "
+GENERATOR_NAME: Final = "pharma-agent-authoring"
+GENERATOR_VERSION: Final = "1"
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Lowercase ASCII words joined by hyphens; Vietnamese marks are removed."""
+    decomposed = unicodedata.normalize("NFKD", text.replace("đ", "d").replace("Đ", "D"))
+    ascii_text = "".join(
+        char
+        for char in decomposed
+        if not unicodedata.combining(char) and char.isascii()
+    )
+    slug = _NON_SLUG_RE.sub("-", ascii_text.lower()).strip("-")
+    return slug[:max_length].rstrip("-")
+
+
+def bundle_document_key(collection_key: str, document_key: str) -> str:
+    """The key of an authored document inside its collection's bundle."""
+    return f"{collection_key}:{document_key}"
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    """``<document_key>#<slug>/<slug>``, or ``<document_key>#body`` for an empty path."""
+    if not path:
+        return f"{document_key}#{_BODY_PART}"
+    parts = (slugify(part) or _EMPTY_SLUG_PART for part in path)
+    return f"{document_key}#{'/'.join(parts)}"
+
+
+@dataclass(frozen=True)
+class MarkdownSection:
+    """One section of an authored document.
+
+    ``path`` holds the enclosing headings including ``heading`` itself; it is empty only
+    for the text before the first heading, which is titled by the fallback heading.
+    """
+
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: tuple[BlockRecord, ...]
+
+
+@dataclass
+class _Draft:
+    heading: str
+    path: tuple[str, ...]
+    lines: list[str]
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[MarkdownSection]:
+    """Sections in reading order; headings inside fenced code do not count.
+
+    Each run of table rows (lines starting with ``|``) becomes a table block keyed
+    ``t1``, ``t2``, ... across the whole document; the text between tables becomes
+    stripped prose blocks. Sections without content are dropped.
+    """
+    drafts = [_Draft(fallback_heading, (), [])]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
+        fence_match = _FENCE_RE.match(line)
+        if fence is not None:
+            if fence_match and _closes(fence, fence_match.group(1), line):
+                fence = None
+            drafts[-1].lines.append(line)
+            continue
+        if fence_match:
+            fence = fence_match.group(1)
+            drafts[-1].lines.append(line)
+            continue
+        heading = _heading(line)
+        if heading is None:
+            drafts[-1].lines.append(line)
+            continue
+        level, text = heading
+        while stack and stack[-1][0] >= level:
+            stack.pop()
+        stack.append((level, text))
+        drafts.append(_Draft(text, tuple(title for _, title in stack), []))
+
+    sections: list[MarkdownSection] = []
+    table_count = 0
+    for draft in drafts:
+        blocks, table_count = _blocks(draft.lines, table_count)
+        if blocks:
+            sections.append(
+                MarkdownSection(
+                    heading=draft.heading,
+                    path=draft.path,
+                    ordinal=len(sections) + 1,
+                    blocks=tuple(blocks),
+                )
+            )
+    return sections
+
+
+def _closes(fence: str, candidate: str, line: str) -> bool:
+    """A closing fence repeats the opening character at least as often, alone."""
+    return (
+        candidate[0] == fence[0]
+        and len(candidate) >= len(fence)
+        and not line.strip().strip(fence[0])
+    )
+
+
+def _heading(line: str) -> tuple[int, str] | None:
+    match = _HEADING_RE.match(line)
+    if match is None:
+        return None
+    text = _CLOSING_HASHES_RE.sub("", match.group(2) or "").strip()
+    if not text:
+        return None
+    return len(match.group(1)), text
+
+
+def _is_table_row(line: str) -> bool:
+    return line.lstrip().startswith("|")
+
+
+def _blocks(lines: Sequence[str], table_count: int) -> tuple[list[BlockRecord], int]:
+    """Blocks of one section's lines and the document-wide table count after them."""
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    rows: list[str] = []
+    in_fence: str | None = None
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        prose.clear()
+
+    def flush_table() -> None:
+        nonlocal table_count
+        if rows:
+            table_count += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(rows),
+                    table_key=f"t{table_count}",
+                )
+            )
+        rows.clear()
+
+    for line in lines:
+        fence_match = _FENCE_RE.match(line)
+        if in_fence is not None:
+            if fence_match and _closes(in_fence, fence_match.group(1), line):
+                in_fence = None
+        elif fence_match:
+            in_fence = fence_match.group(1)
+        elif _is_table_row(line):
+            flush_prose()
+            rows.append(line.rstrip())
+            continue
+        flush_table()
+        prose.append(line)
+    flush_table()
+    flush_prose()
+    return blocks, table_count
+
+
+def section_choices(
+    collection: Collection, documents: Sequence[SourceDocument]
+) -> list[tuple[str, str]]:
+    """(section key, label) pairs in reading order; the label is title › heading path."""
+    return [
+        (key, LABEL_SEPARATOR.join((document.title, *section.path)))
+        for document in documents
+        for key, section in _keyed_sections(collection, document)
+    ]
+
+
+def _keyed_sections(
+    collection: Collection, document: SourceDocument
+) -> list[tuple[str, MarkdownSection]]:
+    """Sections of `document` with their bundle keys, unique within the document.
+
+    A key that is already taken (two equal heading paths) gets ``-2``, ``-3``, ...
+    """
+    document_key = bundle_document_key(collection.key, document.key)
+    keyed: list[tuple[str, MarkdownSection]] = []
+    taken: set[str] = set()
+    for section in split_markdown(document.markdown, fallback_heading=document.title):
+        base = section_key(document_key, section.path)
+        key = base
+        suffix = 1
+        while key in taken:
+            suffix += 1
+            key = f"{base}-{suffix}"
+        taken.add(key)
+        keyed.append((key, section))
+    return keyed
+
+
+def build_bundle(
+    collection: Collection,
+    documents: Sequence[SourceDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    """The knowledge bundle of a collection's authored content.
+
+    Documents are sorted by key, so the input order does not matter. Colloquial mappings
+    keep their order but lose section keys the bundle does not have, and keys an earlier
+    mapping already claims (the bundle allows one mapping per section).
+    """
+    ordered = sorted(
+        documents,
+        key=lambda document: bundle_document_key(collection.key, document.key),
+    )
+    records: list[DocumentRecord] = []
+    sections: list[SectionRecord] = []
+    for document in ordered:
+        document_key = bundle_document_key(collection.key, document.key)
+        records.append(
+            DocumentRecord(
+                key=document_key,
+                kind=document.kind,
+                title=document.title,
+                source=SourceInfo(title=document.source_title, url=document.source_url),
+            )
+        )
+        sections.extend(
+            SectionRecord(
+                key=key,
+                document_key=document_key,
+                heading=section.heading,
+                context_path=list(section.path),
+                ordinal=section.ordinal,
+                blocks=list(section.blocks),
+            )
+            for key, section in _keyed_sections(collection, document)
+        )
+
+    section_keys = {section.key for section in sections}
+    claimed: set[str] = set()
+    mappings: list[ColloquialMappingRecord] = []
+    for mapping in colloquial:
+        kept: list[str] = []
+        for key in mapping.section_keys:
+            if key in section_keys and key not in claimed:
+                claimed.add(key)
+                kept.append(key)
+        mappings.append(mapping.model_copy(update={"section_keys": kept}, deep=True))
+
+    content = KnowledgeBundle(
+        manifest=BundleManifest(
+            schema_version=BUNDLE_SCHEMA_VERSION,
+            collection=BundleCollection(key=collection.key, title=collection.title),
+            generator=BundleGenerator(
+                name=GENERATOR_NAME, version=GENERATOR_VERSION, build_id=""
+            ),
+            source_digests={},
+            document_count=len(records),
+            section_count=len(sections),
+            files={},
+        ),
+        documents=records,
+        sections=sections,
+        glossary=[entry.model_copy(deep=True) for entry in glossary],
+        colloquial_mappings=mappings,
+    )
+    # The build id names the content, so rebuilding unchanged content repeats it.
+    generator = content.manifest.generator.model_copy(
+        update={"build_id": bundle_digest(content)}
+    )
+    return content.model_copy(
+        update={
+            "manifest": content.manifest.model_copy(update={"generator": generator})
+        }
+    )
