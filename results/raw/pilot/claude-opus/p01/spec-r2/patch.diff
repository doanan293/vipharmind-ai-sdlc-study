@@ -0,0 +1,283 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+import pytest
+
+from pharma_agent.domain.corpus.authoring import (
+    build_bundle,
+    bundle_document_key,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    SourceInfo,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import (
+    Collection,
+    build_snapshot,
+    bundle_digest,
+    collection_id_for,
+)
+from pharma_agent.domain.corpus.source import SourceDocument
+
+NOW = datetime(2026, 11, 15, tzinfo=UTC)
+COLLECTION = Collection(id=collection_id_for("kho"), key="kho", title="Kho thuốc")
+
+
+def source_document(key: str, title: str, markdown: str) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid5(uuid.NAMESPACE_URL, key),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.LEAFLET,
+        source_title=f"Nguồn {title}",
+        source_url=None,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=NOW,
+        updated_by=None,
+        updated_at=NOW,
+    )
+
+
+def prose(text: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.PROSE, markdown=text)
+
+
+def table(text: str, key: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.TABLE, markdown=text, table_key=key)
+
+
+@pytest.mark.parametrize(
+    ("text", "slug"),
+    [
+        ("Đường uống", "duong-uong"),
+        ("Liều lượng & cách dùng", "lieu-luong-cach-dung"),
+        ("  Tác dụng không mong muốn (ADR)  ", "tac-dung-khong-mong-muon-adr"),
+        ("Vitamin B12 — 1000 µg", "vitamin-b12-1000-g"),
+        ("!!!", ""),
+        ("", ""),
+    ],
+)
+def test_slugify_removes_vietnamese_marks_and_punctuation(text: str, slug: str) -> None:
+    assert slugify(text) == slug
+
+
+def test_slugify_cuts_to_max_length_without_trailing_hyphen() -> None:
+    assert slugify("abc def ghi", max_length=4) == "abc"
+    assert slugify("abc def ghi", max_length=7) == "abc-def"
+    assert len(slugify("a" * 200)) == 80
+
+
+def test_section_key_joins_slugified_path() -> None:
+    assert (
+        section_key("kho:paracetamol", ("Paracetamol", "Đường uống"))
+        == "kho:paracetamol#paracetamol/duong-uong"
+    )
+    assert section_key("kho:paracetamol", ()) == "kho:paracetamol#body"
+    assert section_key("kho:x", ("???",)) == "kho:x#section"
+
+
+def test_bundle_document_key_prefixes_the_collection() -> None:
+    assert bundle_document_key("kho", "paracetamol") == "kho:paracetamol"
+
+
+DOCUMENT = """Giới thiệu chung.
+
+# Paracetamol
+
+## Liều dùng
+
+### Đường uống #
+
+Người lớn 500 mg.
+
+## Tương tác
+
+| Thuốc | Hậu quả |
+| --- | --- |
+| Warfarin | Tăng INR |
+Theo dõi INR.
+| A | B |
+
+```
+# không phải tiêu đề
+| không phải bảng |
+```
+
+# Phụ lục
+"""
+
+
+def test_split_markdown_builds_heading_paths_and_blocks() -> None:
+    sections = split_markdown(DOCUMENT, fallback_heading="Paracetamol 500")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Paracetamol 500", (), 1),
+        ("Đường uống", ("Paracetamol", "Liều dùng", "Đường uống"), 2),
+        ("Tương tác", ("Paracetamol", "Tương tác"), 3),
+    ]
+    assert sections[0].blocks == (prose("Giới thiệu chung."),)
+    assert sections[1].blocks == (prose("Người lớn 500 mg."),)
+    assert sections[2].blocks == (
+        table("| Thuốc | Hậu quả |\n| --- | --- |\n| Warfarin | Tăng INR |", "t1"),
+        prose("Theo dõi INR."),
+        table("| A | B |", "t2"),
+        prose("```\n# không phải tiêu đề\n| không phải bảng |\n```"),
+    )
+
+
+def test_split_markdown_without_headings_is_one_fallback_section() -> None:
+    sections = split_markdown("\r\n  Chỉ có văn bản.  \r\n", fallback_heading="Tiêu đề")
+
+    assert len(sections) == 1
+    assert sections[0].heading == "Tiêu đề"
+    assert sections[0].path == ()
+    assert sections[0].ordinal == 1
+    assert sections[0].blocks == (prose("Chỉ có văn bản."),)
+
+
+def test_split_markdown_numbers_tables_across_the_document() -> None:
+    sections = split_markdown(
+        "# A\n| 1 |\n# B\n  | 2 |\n| 3 |\n~~~\n# C\n~~~\n",
+        fallback_heading="x",
+    )
+
+    assert [s.path for s in sections] == [("A",), ("B",)]
+    assert sections[0].blocks == (table("| 1 |", "t1"),)
+    assert sections[1].blocks == (
+        table("  | 2 |\n| 3 |", "t2"),
+        prose("~~~\n# C\n~~~"),
+    )
+
+
+def test_split_markdown_drops_empty_sections_and_empty_documents() -> None:
+    assert split_markdown("", fallback_heading="x") == []
+    assert split_markdown("# A\n\n## B\n   \n", fallback_heading="x") == []
+    assert [
+        s.ordinal for s in split_markdown("# A\n\n# B\nb\n# C\nc", fallback_heading="x")
+    ] == [1, 2]
+
+
+def test_section_choices_list_keys_and_labels_in_reading_order() -> None:
+    documents = [
+        source_document("zinc", "Kẽm", "Mở đầu.\n# Liều dùng\n## Trẻ em\n5 mg."),
+        source_document(
+            "acid", "Acid folic", "# Ghi chú\na\n# Ghi chú\nb\n# Ghi chú\nc"
+        ),
+    ]
+
+    assert section_choices(COLLECTION, documents) == [
+        ("kho:zinc#body", "Kẽm"),
+        ("kho:zinc#lieu-dung/tre-em", "Kẽm › Liều dùng › Trẻ em"),
+        ("kho:acid#ghi-chu", "Acid folic › Ghi chú"),
+        ("kho:acid#ghi-chu-2", "Acid folic › Ghi chú"),
+        ("kho:acid#ghi-chu-3", "Acid folic › Ghi chú"),
+    ]
+
+
+GLOSSARY = [
+    GlossaryEntry(term="NSAID", vietnamese_expansions=["thuốc chống viêm"]),
+    GlossaryEntry(term="ADR"),
+]
+DOCUMENTS = [
+    source_document("zinc", "Kẽm", "Mở đầu.\n# Liều dùng\n| a | b |\n## Trẻ em\n5 mg."),
+    source_document("acid", "Acid folic", "Không có tiêu đề."),
+]
+COLLOQUIAL = [
+    ColloquialMappingRecord(
+        key="kem",
+        aliases=["viên kẽm"],
+        section_keys=["kho:zinc#lieu-dung", "kho:zinc#missing", "kho:acid#body"],
+    ),
+    ColloquialMappingRecord(
+        key="trung", section_keys=["kho:acid#body", "nowhere#body"]
+    ),
+]
+
+
+def test_build_bundle_maps_authored_content_to_bundle_records() -> None:
+    bundle = build_bundle(COLLECTION, DOCUMENTS, GLOSSARY, COLLOQUIAL)
+
+    assert bundle.documents == [
+        DocumentRecord(
+            key="kho:acid",
+            kind=DocumentKind.LEAFLET,
+            title="Acid folic",
+            source=SourceInfo(title="Nguồn Acid folic"),
+        ),
+        DocumentRecord(
+            key="kho:zinc",
+            kind=DocumentKind.LEAFLET,
+            title="Kẽm",
+            source=SourceInfo(title="Nguồn Kẽm"),
+        ),
+    ]
+    assert [
+        (s.key, s.document_key, s.heading, s.context_path, s.ordinal)
+        for s in bundle.sections
+    ] == [
+        ("kho:acid#body", "kho:acid", "Acid folic", [], 1),
+        ("kho:zinc#body", "kho:zinc", "Kẽm", [], 1),
+        ("kho:zinc#lieu-dung", "kho:zinc", "Liều dùng", ["Liều dùng"], 2),
+        (
+            "kho:zinc#lieu-dung/tre-em",
+            "kho:zinc",
+            "Trẻ em",
+            ["Liều dùng", "Trẻ em"],
+            3,
+        ),
+    ]
+    assert bundle.sections[2].blocks == [table("| a | b |", "t1")]
+    assert bundle.glossary == GLOSSARY
+    assert [(m.key, m.aliases, m.section_keys) for m in bundle.colloquial_mappings] == [
+        ("kem", ["viên kẽm"], ["kho:zinc#lieu-dung", "kho:acid#body"]),
+        ("trung", [], []),
+    ]
+    manifest = bundle.manifest
+    assert manifest.schema_version == BUNDLE_SCHEMA_VERSION
+    assert manifest.collection == BundleCollection(key="kho", title="Kho thuốc")
+    assert (manifest.document_count, manifest.section_count) == (2, 4)
+
+
+def test_build_bundle_is_deterministic() -> None:
+    first = build_bundle(COLLECTION, DOCUMENTS, GLOSSARY, COLLOQUIAL)
+    second = build_bundle(COLLECTION, list(reversed(DOCUMENTS)), GLOSSARY, COLLOQUIAL)
+
+    assert first == second
+    assert bundle_digest(first) == bundle_digest(second)
+    changed = build_bundle(
+        COLLECTION,
+        [source_document("zinc", "Kẽm", "Khác."), DOCUMENTS[1]],
+        GLOSSARY,
+        COLLOQUIAL,
+    )
+    assert bundle_digest(changed) != bundle_digest(first)
+
+
+def test_build_bundle_passes_bundle_validation_and_import(tmp_path: Path) -> None:
+    bundle = build_bundle(COLLECTION, DOCUMENTS, GLOSSARY, COLLOQUIAL)
+
+    write_bundle(bundle, tmp_path)
+    loaded = read_bundle(tmp_path)
+    snapshot = build_snapshot(loaded)
+
+    assert bundle_digest(loaded) == bundle_digest(bundle)
+    assert snapshot.collection.key == "kho"
+    assert len(snapshot.sections) == 4
+    assert snapshot.chunks
