@@ -0,0 +1,17 @@
+import pytest
+
+from pharma_agent.application.progress import EventType, ProgressEvent
+from pharma_agent.cli import _render
+
+
+def test_done_reports_unsaved_turn(capsys: pytest.CaptureFixture[str]) -> None:
+    _render(ProgressEvent(type=EventType.DONE, data={"persisted": False}), [])
+    assert capsys.readouterr().err == "!! Không lưu được lượt hội thoại này.\n"
+
+
+@pytest.mark.parametrize("data", [{"persisted": True}, {}])
+def test_done_is_silent_when_saved(
+    capsys: pytest.CaptureFixture[str], data: dict[str, object]
+) -> None:
+    _render(ProgressEvent(type=EventType.DONE, data=data), [])
+    assert capsys.readouterr().err == ""
