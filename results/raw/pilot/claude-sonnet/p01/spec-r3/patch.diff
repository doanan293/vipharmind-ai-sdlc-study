+"""Knowledge bundles from authored Markdown documents.
+
+Public API: ``split_markdown``, ``slugify``, ``section_key``, ``section_choices`` and
+``build_bundle``. Everything is pure and deterministic.
+"""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+
+_WORDS_RE = re.compile(r"[a-z0-9]+")
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_LABEL_SEPARATOR = " › "
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Lowercase ASCII words joined by hyphens; Vietnamese marks are removed."""
+    folded = text.replace("Đ", "D").replace("đ", "d")
+    decomposed = unicodedata.normalize("NFKD", folded)
+    ascii_text = "".join(c for c in decomposed if not unicodedata.combining(c))
+    slug = "-".join(_WORDS_RE.findall(ascii_text.lower()))
+    return slug[:max_length].rstrip("-")
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    if not path:
+        return f"{document_key}#body"
+    parts = [slugify(part) or "section" for part in path]
+    return f"{document_key}#{'/'.join(parts)}"
+
+
+@dataclass(frozen=True)
+class Section:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    title: str
+    markdown: str
+    kind: DocumentKind = DocumentKind.GENERAL_MONOGRAPH
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[Section]:
+    """Sections of `markdown`; headings inside fenced code do not count."""
+    # (heading, path, lines) per section, the first one being the untitled preamble.
+    raw: list[tuple[str, tuple[str, ...], list[str]]] = [(fallback_heading, (), [])]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
+        fence_match = _FENCE_RE.match(line)
+        if fence_match:
+            marker = fence_match.group(1)
+            if fence is None:
+                fence = marker
+            elif marker[0] == fence[0] and len(marker) >= len(fence):
+                fence = None
+        elif fence is None and (heading_match := _HEADING_RE.match(line)):
+            level = len(heading_match.group(1))
+            title = heading_match.group(2).strip()
+            while stack and stack[-1][0] >= level:
+                stack.pop()
+            stack.append((level, title))
+            raw.append((title, tuple(name for _, name in stack), []))
+            continue
+        raw[-1][2].append(line)
+
+    sections: list[Section] = []
+    table_count = 0
+    for heading, path, lines in raw:
+        blocks, table_count = _blocks(lines, table_count, fence_aware=True)
+        if blocks:
+            sections.append(Section(heading, path, len(sections) + 1, blocks))
+    return sections
+
+
+def _blocks(
+    lines: list[str], table_count: int, *, fence_aware: bool
+) -> tuple[list[BlockRecord], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    table: list[str] = []
+    fence: str | None = None
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        prose.clear()
+
+    def flush_table() -> None:
+        nonlocal table_count
+        if table:
+            table_count += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(table),
+                    table_key=f"t{table_count}",
+                )
+            )
+            table.clear()
+
+    for line in lines:
+        fence_match = _FENCE_RE.match(line) if fence_aware else None
+        if fence_match:
+            marker = fence_match.group(1)
+            if fence is None:
+                fence = marker
+            elif marker[0] == fence[0] and len(marker) >= len(fence):
+                fence = None
+        if fence is None and not fence_match and line.lstrip().startswith("|"):
+            flush_prose()
+            table.append(line.strip())
+        else:
+            flush_table()
+            prose.append(line)
+    flush_table()
+    flush_prose()
+    return blocks, table_count
+
+
+def _layout(
+    collection_key: str, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, AuthoredDocument, list[tuple[str, Section]]]]:
+    """(bundle document key, document, [(section key, section)]) sorted by key."""
+    keyed = sorted(
+        ((f"{collection_key}:{doc.key}", doc) for doc in documents),
+        key=lambda item: item[0],
+    )
+    layout = []
+    for document_key, doc in keyed:
+        used: dict[str, int] = {}
+        keyed_sections: list[tuple[str, Section]] = []
+        for section in split_markdown(doc.markdown, fallback_heading=doc.title):
+            base = section_key(document_key, section.path)
+            used[base] = used.get(base, 0) + 1
+            key = base if used[base] == 1 else f"{base}-{used[base]}"
+            keyed_sections.append((key, section))
+        layout.append((document_key, doc, keyed_sections))
+    return layout
+
+
+def section_choices(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, str]]:
+    """(section key, label) in reading order; the label is title › heading path."""
+    return [
+        (key, _LABEL_SEPARATOR.join([doc.title, *section.path]))
+        for _, doc, sections in _layout(collection.key, documents)
+        for key, section in sections
+    ]
+
+
+def build_bundle(
+    collection: BundleCollection,
+    documents: Sequence[AuthoredDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    layout = _layout(collection.key, documents)
+    document_records = [
+        DocumentRecord(
+            key=document_key,
+            kind=doc.kind,
+            title=doc.title,
+            source=SourceInfo(title=doc.title),
+        )
+        for document_key, doc, _ in layout
+    ]
+    section_records = [
+        SectionRecord(
+            key=key,
+            document_key=document_key,
+            heading=section.heading,
+            context_path=list(section.path),
+            ordinal=section.ordinal,
+            blocks=list(section.blocks),
+        )
+        for document_key, _, sections in layout
+        for key, section in sections
+    ]
+    known = {record.key for record in section_records}
+    mappings = [
+        mapping.model_copy(
+            update={"section_keys": [k for k in mapping.section_keys if k in known]}
+        )
+        for mapping in colloquial
+    ]
+    manifest = BundleManifest(
+        schema_version="knowledge-bundle/v1",
+        collection=BundleCollection(key=collection.key, title=collection.title),
+        generator=BundleGenerator(
+            name="pharma-agent-authoring", version="1", build_id=collection.key
+        ),
+        source_digests={},
+        document_count=len(document_records),
+        section_count=len(section_records),
+        files={},
+    )
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=document_records,
+        sections=section_records,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
