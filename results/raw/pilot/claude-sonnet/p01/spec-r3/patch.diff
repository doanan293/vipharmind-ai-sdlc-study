@@ -0,0 +1,118 @@
+from pharma_agent.domain.corpus.authoring import section_key, slugify
+
+
+def test_slugify_removes_vietnamese_marks() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Chỉ định & Liều dùng (2) ") == "chi-dinh-lieu-dung-2"
+
+
+def test_slugify_max_length_has_no_trailing_hyphen() -> None:
+    assert slugify("abc def ghi", max_length=4) == "abc"
+    assert len(slugify("x" * 200)) == 80
+
+
+def test_section_key() -> None:
+    assert section_key("c:doc", ()) == "c:doc#body"
+    assert section_key("c:doc", ("Liều dùng", "Trẻ em")) == "c:doc#lieu-dung/tre-em"
+
+
+from pathlib import Path  # noqa: E402
+
+from pharma_agent.domain.corpus.authoring import (  # noqa: E402
+    AuthoredDocument,
+    build_bundle,
+    section_choices,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (  # noqa: E402
+    BlockKind,
+    BundleCollection,
+    ColloquialMappingRecord,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import (  # noqa: E402
+    build_snapshot,
+    bundle_digest,
+)
+
+DOC = """intro text
+
+# Liều dùng
+Uống 1 viên.
+
+| a | b |
+| - | - |
+| 1 | 2 |
+sau bảng
+
+## Trẻ em
+```
+# not a heading
+| x | y |
+```
+
+# Trống
+
+# Tương tác
+| c |
+"""
+
+
+def test_split_markdown_sections_and_blocks() -> None:
+    sections = split_markdown(DOC, fallback_heading="Tổng quan")
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Tổng quan", (), 1),
+        ("Liều dùng", ("Liều dùng",), 2),
+        ("Trẻ em", ("Liều dùng", "Trẻ em"), 3),
+        ("Tương tác", ("Tương tác",), 4),
+    ]
+    assert [(b.kind, b.markdown, b.table_key) for b in sections[1].blocks] == [
+        (BlockKind.PROSE, "Uống 1 viên.", None),
+        (BlockKind.TABLE, "| a | b |\n| - | - |\n| 1 | 2 |", "t1"),
+        (BlockKind.PROSE, "sau bảng", None),
+    ]
+    assert sections[2].blocks[0].kind is BlockKind.PROSE
+    assert "# not a heading" in sections[2].blocks[0].markdown
+    assert sections[3].blocks[0].table_key == "t2"
+
+
+def test_split_markdown_without_headings() -> None:
+    sections = split_markdown("just text", fallback_heading="Body")
+    assert [(s.heading, s.path) for s in sections] == [("Body", ())]
+    assert split_markdown("\n\n", fallback_heading="Body") == []
+
+
+COLLECTION = BundleCollection(key="col", title="Col")
+DOCS = [
+    AuthoredDocument(key="b", title="Bee", markdown="# One\ntext\n# One\nmore"),
+    AuthoredDocument(key="a", title="Ay", markdown="# Đường uống\ntext"),
+]
+
+
+def test_section_choices() -> None:
+    assert section_choices(COLLECTION, DOCS) == [
+        ("col:a#duong-uong", "Ay › Đường uống"),
+        ("col:b#one", "Bee › One"),
+        ("col:b#one-2", "Bee › One"),
+    ]
+
+
+def test_build_bundle(tmp_path: Path) -> None:
+    mapping = ColloquialMappingRecord(
+        key="m", section_keys=["col:a#duong-uong", "col:zzz#body"]
+    )
+    glossary = [GlossaryEntry(term="x")]
+    bundle = build_bundle(COLLECTION, DOCS, glossary, [mapping])
+    assert [d.key for d in bundle.documents] == ["col:a", "col:b"]
+    assert bundle.manifest.collection == COLLECTION
+    assert (bundle.manifest.document_count, bundle.manifest.section_count) == (2, 3)
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == ["col:a#duong-uong"]
+    assert bundle_digest(bundle) == bundle_digest(
+        build_bundle(COLLECTION, list(reversed(DOCS)), glossary, [mapping])
+    )
+    write_bundle(bundle, tmp_path)
+    assert bundle_digest(read_bundle(tmp_path)) == bundle_digest(bundle)
+    build_snapshot(bundle)
