+"""Build a knowledge bundle from authored Markdown documents.
+
+Pure and deterministic: the same content always gives the same bundle digest.
+"""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_WORD_RE = re.compile(r"[a-z0-9]+")
+_LABEL_SEPARATOR = " › "
+
+
+@dataclass(frozen=True)
+class Section:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    title: str
+    markdown: str
+    kind: DocumentKind = DocumentKind.GENERAL_MONOGRAPH
+    source_title: str | None = None
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[Section]:
+    """Split on ATX headings outside fenced code; drop sections with no content."""
+    # Each raw section: (heading, path, lines) where lines are (text, in_fence).
+    raw: list[tuple[str, tuple[str, ...], list[tuple[str, bool]]]] = [
+        (fallback_heading, (), [])
+    ]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in markdown.splitlines():
+        fence_match = _FENCE_RE.match(line)
+        if fence is not None:
+            raw[-1][2].append((line, True))
+            if (
+                fence_match
+                and fence_match.group(1)[0] == fence[0]
+                and len(fence_match.group(1)) >= len(fence)
+                and not line.strip()[len(fence_match.group(1)) :].strip()
+            ):
+                fence = None
+            continue
+        if fence_match:
+            fence = fence_match.group(1)
+            raw[-1][2].append((line, True))
+            continue
+        heading = _HEADING_RE.match(line)
+        if heading:
+            level, text = len(heading.group(1)), heading.group(2).strip()
+            while stack and stack[-1][0] >= level:
+                stack.pop()
+            stack.append((level, text))
+            raw.append((text, tuple(part for _, part in stack), []))
+            continue
+        raw[-1][2].append((line, False))
+
+    sections: list[Section] = []
+    table_count = 0
+    for heading, path, lines in raw:
+        blocks, table_count = _blocks(lines, table_count)
+        if blocks:
+            sections.append(Section(heading, path, len(sections), blocks))
+    return sections
+
+
+def _blocks(
+    lines: Sequence[tuple[str, bool]], table_count: int
+) -> tuple[list[BlockRecord], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    table: list[str] = []
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        prose.clear()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+
+    def flush_table() -> None:
+        nonlocal table_count
+        if table:
+            table_count += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(table),
+                    table_key=f"t{table_count}",
+                )
+            )
+            table.clear()
+
+    for text, in_fence in lines:
+        if not in_fence and text.startswith("|"):
+            flush_prose()
+            table.append(text.rstrip())
+        else:
+            flush_table()
+            prose.append(text)
+    flush_table()
+    flush_prose()
+    return blocks, table_count
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    folded = unicodedata.normalize("NFD", text.replace("đ", "d").replace("Đ", "D"))
+    ascii_text = "".join(c for c in folded if not unicodedata.combining(c))
+    ascii_text = ascii_text.encode("ascii", "ignore").decode().lower()
+    return "-".join(_WORD_RE.findall(ascii_text))[:max_length].strip("-")
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    if not path:
+        return f"{document_key}#body"
+    return f"{document_key}#{'/'.join(slugify(part) for part in path)}"
+
+
+def bundle_document_key(collection_key: str, document_key: str) -> str:
+    return f"{collection_key}:{document_key}"
+
+
+def _keyed_sections(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, AuthoredDocument, Section, str]]:
+    """(document key, document, section, unique section key) in bundle order."""
+    rows: list[tuple[str, AuthoredDocument, Section, str]] = []
+    for document in sorted(documents, key=lambda d: d.key):
+        doc_key = bundle_document_key(collection.key, document.key)
+        seen: set[str] = set()
+        for section in split_markdown(
+            document.markdown, fallback_heading=document.title
+        ):
+            base = section_key(doc_key, section.path)
+            key, n = base, 1
+            while key in seen:
+                n += 1
+                key = f"{base}-{n}"
+            seen.add(key)
+            rows.append((doc_key, document, section, key))
+    return rows
+
+
+def section_choices(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, str]]:
+    return [
+        (key, _LABEL_SEPARATOR.join((document.title, *section.path)))
+        for _, document, section, key in _keyed_sections(collection, documents)
+    ]
+
+
+def build_bundle(
+    collection: BundleCollection,
+    documents: Sequence[AuthoredDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    ordered = sorted(documents, key=lambda d: d.key)
+    rows = _keyed_sections(collection, documents)
+    known = {key for _, _, _, key in rows}
+    return KnowledgeBundle(
+        manifest=BundleManifest(
+            schema_version=BUNDLE_SCHEMA_VERSION,
+            collection=BundleCollection(key=collection.key, title=collection.title),
+            generator=BundleGenerator(
+                name="pharma-agent-authoring", version="1", build_id="authoring"
+            ),
+            source_digests={},
+            document_count=len(ordered),
+            section_count=len(rows),
+            files={},
+        ),
+        documents=[
+            DocumentRecord(
+                key=bundle_document_key(collection.key, d.key),
+                kind=d.kind,
+                title=d.title,
+                source=SourceInfo(title=d.source_title or d.title),
+            )
+            for d in ordered
+        ],
+        sections=[
+            SectionRecord(
+                key=key,
+                document_key=doc_key,
+                heading=section.heading,
+                context_path=list(section.path),
+                ordinal=section.ordinal,
+                blocks=section.blocks,
+            )
+            for doc_key, _, section, key in rows
+        ],
+        glossary=list(glossary),
+        colloquial_mappings=[
+            record.model_copy(
+                update={"section_keys": [k for k in record.section_keys if k in known]}
+            )
+            for record in colloquial
+        ],
+    )
