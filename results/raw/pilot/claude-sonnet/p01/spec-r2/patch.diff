@@ -0,0 +1,120 @@
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    build_bundle,
+    bundle_document_key,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BundleCollection,
+    ColloquialMappingRecord,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import bundle_digest
+
+DOC = """intro text
+
+# Title
+## Dose
+Take daily.
+| a | b |
+| - | - |
+| 1 | 2 |
+between
+| c |
+## Empty
+# Other
+```
+# not heading
+| not | table |
+```
+"""
+
+
+def test_split_paths_ordinals_and_blocks() -> None:
+    sections = split_markdown(DOC, fallback_heading="Body")
+
+    assert [s.heading for s in sections] == ["Body", "Dose", "Other"]
+    assert [s.path for s in sections] == [(), ("Title", "Dose"), ("Other",)]
+    assert [s.ordinal for s in sections] == [0, 1, 2]
+    assert [b.markdown for b in sections[0].blocks] == ["intro text"]
+    dose = sections[1].blocks
+    assert [(b.kind, b.table_key) for b in dose] == [
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t1"),
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t2"),
+    ]
+    assert dose[0].markdown == "Take daily."
+    assert dose[1].markdown == "| a | b |\n| - | - |\n| 1 | 2 |"
+    assert [b.kind for b in sections[2].blocks] == [BlockKind.PROSE]
+    assert "# not heading" in sections[2].blocks[0].markdown
+
+
+def test_split_without_headings_uses_fallback() -> None:
+    sections = split_markdown("just text", fallback_heading="Nội dung")
+    assert [(s.heading, s.path) for s in sections] == [("Nội dung", ())]
+    assert split_markdown("  \n", fallback_heading="x") == []
+
+
+def test_slugify_and_keys() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("Hello,  World!") == "hello-world"
+    assert slugify("abc def ghi", max_length=7) == "abc-def"
+    assert section_key("c:d", ("Đường uống", "Liều")) == "c:d#duong-uong/lieu"
+    assert section_key("c:d", ()) == "c:d#body"
+    assert bundle_document_key("c", "d") == "c:d"
+
+
+def _docs() -> list[AuthoredDocument]:
+    return [
+        AuthoredDocument(key="b", title="B", markdown="# X\nx\n# X\ny"),
+        AuthoredDocument(key="a", title="A", markdown="hi\n# Đường uống\nz"),
+    ]
+
+
+def test_choices_in_reading_order() -> None:
+    choices = section_choices(BundleCollection(key="c", title="C"), _docs())
+    assert choices == [
+        ("c:a#body", "A"),
+        ("c:a#duong-uong", "A › Đường uống"),
+        ("c:b#x", "B › X"),
+        ("c:b#x-2", "B › X"),
+    ]
+
+
+def test_build_bundle(tmp_path: Path) -> None:
+    collection = BundleCollection(key="c", title="C")
+    glossary = [GlossaryEntry(term="t")]
+    colloquial = [
+        ColloquialMappingRecord(key="k", section_keys=["c:a#body", "c:zz#nope"])
+    ]
+    bundle = build_bundle(collection, _docs(), glossary, colloquial)
+
+    assert [d.key for d in bundle.documents] == ["c:a", "c:b"]
+    assert [s.key for s in bundle.sections] == [
+        k for k, _ in section_choices(collection, _docs())
+    ]
+    assert bundle.sections[1].context_path == ["Đường uống"]
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == ["c:a#body"]
+    assert bundle.manifest.collection == collection
+    assert (bundle.manifest.document_count, bundle.manifest.section_count) == (2, 4)
+
+    write_bundle(bundle, tmp_path)
+    assert read_bundle(tmp_path).sections == bundle.sections
+
+
+def test_bundle_is_deterministic() -> None:
+    collection = BundleCollection(key="c", title="C")
+    first = build_bundle(collection, _docs(), [], [])
+    second = build_bundle(collection, list(reversed(_docs())), [], [])
+    assert bundle_digest(first) == bundle_digest(second)
+    assert first == second
