# Thư mục làm việc của superpowers (sổ theo dõi, bản tóm tắt nhiệm vụ)
.superpowers/

# File trung gian của LaTeX; PDF được commit
*.aux
*.log
*.fls
*.fdb_latexmk
*.xdv
*.bbl
*.blg
*.out
*.synctex.gz

# Skill cài cục bộ (ppt-master, latex-document-skill); cài lại theo skills-lock.json
.agents/
.claude/skills/

# Account credential sources for harness runs; never commit
code/harness/accounts.local.toml

# Harness workspaces and reference-run cache (sdlc-harness run from the repo root)
/.work/

# Báo cáo: file trung gian của check.sh và LaTeX
docs/report/build.out
docs/report/body.txt
*.toc
*.lot
*.lof

# Run logs are results (the *.log rule above is for LaTeX)
!data/results/**/*.log

# Gói việc gửi Lợi, Bảo: sinh lại được bằng analysis/scripts (hạt giống cố định); có khóa làm mù và bản zip trùng
/data/results/packets/

# Khóa làm mù (nối mã lượt với cách làm): chỉ giữ trên máy An, không commit
*-PRIVATE*.csv
