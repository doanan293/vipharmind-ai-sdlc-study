+"""Build importable corpus bundles from authored Markdown."""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+
+
+@dataclass(frozen=True)
+class AuthoredSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    title: str
+    markdown: str
+    fallback_heading: str
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[AuthoredSection]:
+    """Split markdown into nonempty heading sections and prose/table blocks."""
+    sections: list[AuthoredSection] = []
+    headings: list[tuple[int, str]] = []
+    current_heading = fallback_heading
+    current_path: tuple[str, ...] = ()
+    content: list[str] = []
+    blocks: list[BlockRecord] = []
+    table_number = 0
+    fence_char: str | None = None
+    fence_size = 0
+
+    def flush_content() -> None:
+        nonlocal content, table_number
+        lines = content
+        content = []
+        i = 0
+        while i < len(lines):
+            is_table = lines[i].lstrip().startswith("|")
+            j = i + 1
+            while j < len(lines) and lines[j].lstrip().startswith("|") == is_table:
+                j += 1
+            text = "\n".join(line.replace("\x00", "") for line in lines[i:j]).strip()
+            if text:
+                if is_table:
+                    table_number += 1
+                    blocks.append(
+                        BlockRecord(
+                            kind=BlockKind.TABLE,
+                            markdown=text,
+                            table_key=f"t{table_number}",
+                        )
+                    )
+                else:
+                    blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+            i = j
+
+    def finish() -> None:
+        nonlocal blocks
+        flush_content()
+        if blocks:
+            sections.append(
+                AuthoredSection(
+                    current_heading, current_path, len(sections) + 1, blocks
+                )
+            )
+        blocks = []
+
+    for line in markdown.splitlines():
+        fence = re.match(r"^\s*(`{3,}|~{3,})", line)
+        if fence:
+            marker = fence.group(1)
+            if fence_char is None:
+                fence_char, fence_size = marker[0], len(marker)
+            elif marker[0] == fence_char and len(marker) >= fence_size:
+                fence_char = None
+            content.append(line)
+            continue
+        heading = (
+            None if fence_char else re.match(r"^ {0,3}(#{1,6})\s+(.+?)\s*#*\s*$", line)
+        )
+        if heading:
+            finish()
+            level, title = len(heading.group(1)), heading.group(2).strip()
+            headings = [(n, h) for n, h in headings if n < level]
+            headings.append((level, title))
+            current_heading = title
+            current_path = tuple(h for _, h in headings)
+        else:
+            content.append(
+                "\x00" + line
+                if fence_char is not None and line.lstrip().startswith("|")
+                else line
+            )
+    finish()
+    return sections
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    text = text.replace("Đ", "D").replace("đ", "d")
+    normalized = unicodedata.normalize("NFKD", text)
+    ascii_text = normalized.encode("ascii", "ignore").decode("ascii").lower()
+    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
+    clipped = slug[:max_length].rstrip("-")
+    if len(slug) > max_length and "-" in clipped:
+        clipped = clipped.rsplit("-", 1)[0]
+    return clipped
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    suffix = "/".join(filter(None, (slugify(part) for part in path))) or "body"
+    return f"{document_key}#{suffix}"
+
+
+def _document_key(collection: BundleCollection, document: AuthoredDocument) -> str:
+    return f"{collection.key}:{document.key}"
+
+
+def section_choices(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, str]]:
+    choices = []
+    for document in documents:
+        for section in split_markdown(
+            document.markdown, fallback_heading=document.fallback_heading
+        ):
+            path = section.path or (section.heading,)
+            choices.append(
+                (
+                    section_key(_document_key(collection, document), section.path),
+                    " › ".join((document.title, *path)),
+                )
+            )
+    return choices
+
+
+def build_bundle(
+    collection: BundleCollection,
+    documents: Sequence[AuthoredDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    records: list[DocumentRecord] = []
+    sections: list[SectionRecord] = []
+    for authored in documents:
+        doc_key = _document_key(collection, authored)
+        records.append(
+            DocumentRecord(
+                key=doc_key,
+                kind=DocumentKind.GENERAL_MONOGRAPH,
+                title=authored.title,
+                source=SourceInfo(title=authored.title),
+            )
+        )
+        for parsed in split_markdown(
+            authored.markdown, fallback_heading=authored.fallback_heading
+        ):
+            sections.append(
+                SectionRecord(
+                    key=section_key(doc_key, parsed.path),
+                    document_key=doc_key,
+                    heading=parsed.heading,
+                    context_path=list(parsed.path),
+                    ordinal=parsed.ordinal,
+                    blocks=parsed.blocks,
+                )
+            )
+    records.sort(key=lambda item: item.key)
+    section_keys = {section.key for section in sections}
+    mappings = [
+        mapping.model_copy(
+            update={
+                "section_keys": [
+                    key for key in mapping.section_keys if key in section_keys
+                ]
+            }
+        )
+        for mapping in colloquial
+    ]
+    mappings = [mapping for mapping in mappings if mapping.section_keys]
+    return KnowledgeBundle(
+        manifest=BundleManifest(
+            schema_version=BUNDLE_SCHEMA_VERSION,
+            collection=collection,
+            generator=BundleGenerator(
+                name="pharma-agent-authoring", version="1", build_id="authored-markdown"
+            ),
+            source_digests={},
+            document_count=len(records),
+            section_count=len(sections),
+            files={},
+        ),
+        documents=records,
+        sections=sections,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
diff --git a/backend/tests/domain/corpus/test_authoring.py b/backend/tests/domain/corpus/test_authoring.py
new file mode 100644
index 0000000..71674b3
--- /dev/null
+++ b/backend/tests/domain/corpus/test_authoring.py
@@ -0,0 +1,68 @@
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BundleCollection,
+    ColloquialMappingRecord,
+    GlossaryEntry,
+)
+from pharma_agent.domain.corpus.models import bundle_digest
+
+
+def test_split_markdown_tracks_headings_tables_and_fences() -> None:
+    sections = split_markdown(
+        "intro\n\n# Dose\n text \n| a |\n| b |\nprose\n```md\n## not heading\n| code |\n```\n## Empty\n## Route\nlast",
+        fallback_heading="Body",
+    )
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Body", (), 1),
+        ("Dose", ("Dose",), 2),
+        ("Route", ("Dose", "Route"), 3),
+    ]
+    assert sections[0].blocks[0].markdown == "intro"
+    assert [b.kind for b in sections[1].blocks] == [
+        BlockKind.PROSE,
+        BlockKind.TABLE,
+        BlockKind.PROSE,
+    ]
+    assert sections[1].blocks[1].table_key == "t1"
+    assert "## not heading" in sections[1].blocks[-1].markdown
+
+
+def test_slug_and_section_keys() -> None:
+    assert slugify("Đường uống", max_length=80) == "duong-uong"
+    assert slugify("A very long heading", max_length=8) == "a-very"
+    assert section_key("c:d", ()) == "c:d#body"
+    assert section_key("c:d", ("Đường uống", "Cách dùng")) == "c:d#duong-uong/cach-dung"
+
+
+def test_choices_and_build_bundle_are_scoped_clean_and_deterministic() -> None:
+    collection = BundleCollection(key="formulary", title="Formulary")
+    docs = [
+        AuthoredDocument(
+            key="z", title="Zulu", markdown="# Route\nText", fallback_heading="Body"
+        ),
+        AuthoredDocument(
+            key="a", title="Alpha", markdown="Text", fallback_heading="Body"
+        ),
+    ]
+    assert section_choices(collection, docs) == [
+        ("formulary:z#route", "Zulu › Route"),
+        ("formulary:a#body", "Alpha › Body"),
+    ]
+    stale = ColloquialMappingRecord(key="m", section_keys=["missing"])
+    glossary = [GlossaryEntry(term="dose")]
+    bundle = build_bundle(collection, docs, glossary, [stale])
+    assert [d.key for d in bundle.documents] == ["formulary:a", "formulary:z"]
+    assert bundle.manifest.document_count == 2 and bundle.manifest.section_count == 2
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings == []
+    assert bundle_digest(bundle) == bundle_digest(
+        build_bundle(collection, docs, glossary, [stale])
+    )
