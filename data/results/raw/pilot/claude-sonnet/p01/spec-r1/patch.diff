@@ -0,0 +1,122 @@
+import hashlib
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BundleCollection,
+    ColloquialMappingRecord,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+
+
+def test_slugify_removes_vietnamese_marks() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Liều dùng / Cách dùng!! ") == "lieu-dung-cach-dung"
+
+
+def test_slugify_max_length() -> None:
+    assert slugify("abc def ghi", max_length=5) == "abc-d"
+    assert slugify("abc def", max_length=4) == "abc"
+
+
+def test_section_key() -> None:
+    assert section_key("c:d", ()) == "c:d#body"
+    assert section_key("c:d", ("Chỉ định", "Người lớn")) == "c:d#chi-dinh/nguoi-lon"
+
+
+def test_split_basic_paths_and_ordinals() -> None:
+    md = "intro\n\n# A\ntext a\n## B\ntext b\n# C\n\n# D\ntext d\n"
+    sections = split_markdown(md, fallback_heading="Body")
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Body", (), 0),
+        ("A", ("A",), 1),
+        ("B", ("A", "B"), 2),
+        ("D", ("D",), 3),
+    ]
+    assert sections[1].blocks[0].kind is BlockKind.PROSE
+    assert sections[1].blocks[0].markdown == "text a"
+
+
+def test_split_without_headings_and_empty() -> None:
+    sections = split_markdown("just text", fallback_heading="Body")
+    assert [(s.heading, s.path) for s in sections] == [("Body", ())]
+    assert split_markdown("\n \n", fallback_heading="Body") == []
+
+
+def test_headings_in_fences_ignored() -> None:
+    md = "# A\n```\n# not heading\n```\n~~~\n## nope\n~~~\n"
+    sections = split_markdown(md, fallback_heading="Body")
+    assert [s.heading for s in sections] == ["A"]
+    assert "# not heading" in sections[0].blocks[0].markdown
+
+
+def test_tables_numbered_across_document() -> None:
+    md = "# A\nbefore\n| h |\n|---|\n| 1 |\nmiddle\n| x |\n# B\n| y |\n"
+    a, b = split_markdown(md, fallback_heading="Body")
+    assert [(k.kind, k.table_key) for k in a.blocks] == [
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t1"),
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t2"),
+    ]
+    assert a.blocks[1].markdown == "| h |\n|---|\n| 1 |"
+    assert a.blocks[2].markdown == "middle"
+    assert [(k.kind, k.table_key) for k in b.blocks] == [(BlockKind.TABLE, "t3")]
+
+
+COLLECTION = BundleCollection(key="col", title="Col")
+
+
+def _docs() -> list[AuthoredDocument]:
+    return [
+        AuthoredDocument(key="b", title="Bee", markdown="# Một\nx\n## Hai\ny\n"),
+        AuthoredDocument(key="a", title="Ay", markdown="plain\n# Dup\n1\n# Dup\n2\n"),
+    ]
+
+
+def test_section_choices() -> None:
+    assert section_choices(COLLECTION, _docs()) == [
+        ("col:a#body", "Ay"),
+        ("col:a#dup", "Ay › Dup"),
+        ("col:a#dup-2", "Ay › Dup"),
+        ("col:b#mot", "Bee › Một"),
+        ("col:b#mot/hai", "Bee › Một › Hai"),
+    ]
+
+
+def test_build_bundle(tmp_path: Path) -> None:
+    mappings = [
+        ColloquialMappingRecord(key="k", section_keys=["col:b#mot", "col:zzz#body"])
+    ]
+    glossary = [GlossaryEntry(term="t")]
+    bundle = build_bundle(COLLECTION, _docs(), glossary, mappings)
+    assert [d.key for d in bundle.documents] == ["col:a", "col:b"]
+    assert [s.key for s in bundle.sections] == [
+        k for k, _ in section_choices(COLLECTION, _docs())
+    ]
+    assert bundle.sections[4].context_path == ["Một", "Hai"]
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == ["col:b#mot"]
+    assert bundle.manifest.collection == COLLECTION
+    assert (bundle.manifest.document_count, bundle.manifest.section_count) == (2, 5)
+
+    write_bundle(bundle, tmp_path / "one")
+    write_bundle(
+        build_bundle(COLLECTION, list(reversed(_docs())), glossary, mappings),
+        tmp_path / "two",
+    )
+    read_bundle(tmp_path / "one")
+    for name in ("manifest.json", "sections.jsonl", "documents.jsonl"):
+        one = hashlib.sha256((tmp_path / "one" / name).read_bytes()).hexdigest()
+        two = hashlib.sha256((tmp_path / "two" / name).read_bytes()).hexdigest()
+        assert one == two
