+"""Build a knowledge bundle from authored Markdown documents.
+
+Public API: ``split_markdown``, ``slugify``, ``section_key``, ``section_choices`` and
+``build_bundle``. Pure and deterministic: the same content gives the same bundle.
+"""
+
+import re
+import unicodedata
+from collections.abc import Iterator, Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.*?)[ \t]*#*[ \t]*$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_NON_WORD_RE = re.compile(r"[^a-z0-9]+")
+_LABEL_SEPARATOR = " › "
+
+
+@dataclass(frozen=True)
+class MarkdownSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    title: str
+    markdown: str
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    decomposed = unicodedata.normalize("NFD", text.replace("Đ", "D").replace("đ", "d"))
+    ascii_text = "".join(c for c in decomposed if not unicodedata.combining(c))
+    slug = _NON_WORD_RE.sub("-", ascii_text.lower().encode("ascii", "ignore").decode())
+    return slug.strip("-")[:max_length].strip("-")
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    if not path:
+        return f"{document_key}#body"
+    return f"{document_key}#" + "/".join(slugify(part) or "section" for part in path)
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[MarkdownSection]:
+    raw: list[tuple[str, tuple[str, ...], list[str]]] = [(fallback_heading, (), [])]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in markdown.splitlines():
+        fence_match = _FENCE_RE.match(line)
+        if fence_match:
+            marker = fence_match.group(1)
+            if fence is None:
+                fence = marker
+            elif marker[0] == fence[0] and len(marker) >= len(fence):
+                fence = None
+        heading = None if fence is not None or fence_match else _HEADING_RE.match(line)
+        if heading:
+            level, title = len(heading.group(1)), heading.group(2).strip()
+            while stack and stack[-1][0] >= level:
+                stack.pop()
+            stack.append((level, title))
+            raw.append((title, tuple(t for _, t in stack), []))
+        else:
+            raw[-1][2].append(line)
+
+    sections: list[MarkdownSection] = []
+    table_count = 0
+    for heading_text, path, lines in raw:
+        blocks, table_count = _blocks(lines, table_count)
+        if blocks:
+            sections.append(MarkdownSection(heading_text, path, len(sections), blocks))
+    return sections
+
+
+def _blocks(lines: Sequence[str], table_count: int) -> tuple[list[BlockRecord], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    table: list[str] = []
+    fence: str | None = None
+
+    def flush_prose() -> None:
+        text = "\n".join(prose).strip()
+        prose.clear()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+
+    def flush_table() -> None:
+        nonlocal table_count
+        if table:
+            table_count += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(table),
+                    table_key=f"t{table_count}",
+                )
+            )
+            table.clear()
+
+    for line in lines:
+        fence_match = _FENCE_RE.match(line)
+        if fence_match:
+            marker = fence_match.group(1)
+            if fence is None:
+                fence = marker
+            elif marker[0] == fence[0] and len(marker) >= len(fence):
+                fence = None
+        elif fence is None and line.startswith("|"):
+            flush_prose()
+            table.append(line.rstrip())
+            continue
+        flush_table()
+        prose.append(line)
+    flush_table()
+    flush_prose()
+    return blocks, table_count
+
+
+def _document_key(collection: BundleCollection, document: AuthoredDocument) -> str:
+    return f"{collection.key}:{document.key}"
+
+
+def _keyed_sections(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> Iterator[tuple[str, AuthoredDocument, MarkdownSection]]:
+    """(section key, document, section) in reading order, keys unique per document."""
+    for document in sorted(documents, key=lambda d: _document_key(collection, d)):
+        doc_key = _document_key(collection, document)
+        seen: dict[str, int] = {}
+        for section in split_markdown(
+            document.markdown, fallback_heading=document.title
+        ):
+            base = section_key(doc_key, section.path)
+            seen[base] = seen.get(base, 0) + 1
+            key = base if seen[base] == 1 else f"{base}-{seen[base]}"
+            yield key, document, section
+
+
+def section_choices(
+    collection: BundleCollection, documents: Sequence[AuthoredDocument]
+) -> list[tuple[str, str]]:
+    return [
+        (key, _LABEL_SEPARATOR.join((document.title, *section.path)))
+        for key, document, section in _keyed_sections(collection, documents)
+    ]
+
+
+def build_bundle(
+    collection: BundleCollection,
+    documents: Sequence[AuthoredDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    records = [
+        DocumentRecord(
+            key=_document_key(collection, document),
+            kind=DocumentKind.GENERAL_MONOGRAPH,
+            title=document.title,
+            source=SourceInfo(title=document.title),
+        )
+        for document in sorted(documents, key=lambda d: _document_key(collection, d))
+    ]
+    sections = [
+        SectionRecord(
+            key=key,
+            document_key=_document_key(collection, document),
+            heading=section.heading,
+            context_path=list(section.path),
+            ordinal=section.ordinal,
+            blocks=section.blocks,
+        )
+        for key, document, section in _keyed_sections(collection, documents)
+    ]
+    known = {section.key for section in sections}
+    mappings = [
+        record.model_copy(
+            update={"section_keys": [k for k in record.section_keys if k in known]}
+        )
+        for record in colloquial
+    ]
+    manifest = BundleManifest(
+        schema_version="knowledge-bundle/v1",
+        collection=collection,
+        generator=BundleGenerator(
+            name="pharma-agent-authoring", version="1", build_id="authoring"
+        ),
+        source_digests={},
+        document_count=len(records),
+        section_count=len(sections),
+        files={},
+    )
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=records,
+        sections=sections,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
