+"""Build a knowledge bundle from authored Markdown documents.
+
+Authored documents, glossary entries and colloquial mappings are transformed into
+a deterministic KnowledgeBundle compatible with the corpus import pipeline.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    RetrievalMode,
+    SectionRecord,
+    SourceInfo,
+)
+
+_FENCE_START_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})\s+(.*?)(?:\s+#+)?$")
+
+
+@dataclass(frozen=True)
+class AuthoredSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: list[BlockRecord]
+
+
+@dataclass(frozen=True)
+class AuthoredDocument:
+    key: str
+    title: str
+    markdown: str
+    kind: DocumentKind = DocumentKind.LEAFLET
+    source_title: str | None = None
+    source_url: str | None = None
+    attributes: dict[str, str | int | float | bool | None] = field(default_factory=dict)
+
+
+def strip_accents(text: str) -> str:
+    """Remove Vietnamese diacritics and normalize characters."""
+    text = (
+        text.replace("đ", "d")
+        .replace("Đ", "D")
+        .replace("ð", "d")
+        .replace("Ð", "D")
+    )
+    return "".join(
+        char
+        for char in unicodedata.normalize("NFD", text)
+        if unicodedata.category(char) != "Mn"
+    )
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Produce lowercase ASCII words joined by hyphens with Vietnamese marks removed."""
+    ascii_text = strip_accents(text).lower()
+    words = re.findall(r"[a-z0-9]+", ascii_text)
+    slug = "-".join(words)
+    if max_length is not None and len(slug) > max_length:
+        slug = slug[:max_length].rstrip("-")
+    return slug
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    """Return <document_key>#<slugified path parts joined by "/">, or <document_key>#body."""
+    if not path:
+        return f"{document_key}#body"
+    slugs = [slugify(part) for part in path]
+    joined = "/".join(s for s in slugs if s)
+    if not joined:
+        return f"{document_key}#body"
+    return f"{document_key}#{joined}"
+
+
+def _parse_blocks(lines: Sequence[str], table_counter: list[int]) -> list[BlockRecord]:
+    blocks: list[BlockRecord] = []
+    runs: list[tuple[bool, list[str]]] = []
+    current_run_is_table: bool | None = None
+    current_run: list[str] = []
+
+    in_fence = False
+    fence_char = ""
+    fence_len = 0
+
+    for line in lines:
+        if not in_fence:
+            m = _FENCE_START_RE.match(line)
+            if m:
+                in_fence = True
+                fence_char = m.group(1)[0]
+                fence_len = len(m.group(1))
+                is_table = False
+            else:
+                is_table = line.strip().startswith("|")
+        else:
+            is_table = False
+            if re.match(rf"^ {{0,3}}\{fence_char}{{{fence_len},}}\s*$", line):
+                in_fence = False
+
+        if is_table != current_run_is_table:
+            if current_run:
+                runs.append((current_run_is_table, current_run))
+            current_run_is_table = is_table
+            current_run = [line]
+        else:
+            current_run.append(line)
+
+    if current_run and current_run_is_table is not None:
+        runs.append((current_run_is_table, current_run))
+
+    for is_table, run_lines in runs:
+        text = "\n".join(run_lines).strip()
+        if not text:
+            continue
+        if is_table:
+            key = f"t{table_counter[0]}"
+            table_counter[0] += 1
+            blocks.append(
+                BlockRecord(kind=BlockKind.TABLE, markdown=text, table_key=key)
+            )
+        else:
+            blocks.append(
+                BlockRecord(kind=BlockKind.PROSE, markdown=text, table_key=None)
+            )
+    return blocks
+
+
+def split_markdown(
+    markdown: str, *, fallback_heading: str = "Thông tin chung"
+) -> list[AuthoredSection]:
+    """Split authored markdown into sections with heading, path, ordinal and blocks."""
+    lines = markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n")
+    sections: list[AuthoredSection] = []
+    heading_stack: list[tuple[int, str]] = []
+    current_heading = fallback_heading
+    current_path: tuple[str, ...] = ()
+    current_lines: list[str] = []
+    current_ordinal = 1
+    table_counter = [1]
+
+    in_fence = False
+    fence_char = ""
+    fence_len = 0
+
+    for line in lines:
+        if not in_fence:
+            m = _FENCE_START_RE.match(line)
+            if m:
+                in_fence = True
+                fence_char = m.group(1)[0]
+                fence_len = len(m.group(1))
+                current_lines.append(line)
+                continue
+        else:
+            if re.match(rf"^ {{0,3}}\{fence_char}{{{fence_len},}}\s*$", line):
+                in_fence = False
+            current_lines.append(line)
+            continue
+
+        h_match = _HEADING_RE.match(line)
+        if h_match:
+            blocks = _parse_blocks(current_lines, table_counter)
+            if blocks:
+                sections.append(
+                    AuthoredSection(
+                        heading=current_heading,
+                        path=current_path,
+                        ordinal=current_ordinal,
+                        blocks=blocks,
+                    )
+                )
+                current_ordinal += 1
+
+            level = len(h_match.group(1))
+            heading_text = h_match.group(2).strip()
+            while heading_stack and heading_stack[-1][0] >= level:
+                heading_stack.pop()
+            heading_stack.append((level, heading_text))
+
+            current_heading = heading_text
+            current_path = tuple(h for _, h in heading_stack)
+            current_lines = []
+        else:
+            current_lines.append(line)
+
+    blocks = _parse_blocks(current_lines, table_counter)
+    if blocks:
+        sections.append(
+            AuthoredSection(
+                heading=current_heading,
+                path=current_path,
+                ordinal=current_ordinal,
+                blocks=blocks,
+            )
+        )
+
+    return sections
+
+
+def section_choices(
+    collection: Any, documents: Iterable[Any]
+) -> list[tuple[str, str]]:
+    """Return (section key, label) pairs in reading order."""
+    col_key = collection.key if hasattr(collection, "key") else collection["key"]
+    choices: list[tuple[str, str]] = []
+
+    for doc in documents:
+        doc_key = doc.key if hasattr(doc, "key") else doc["key"]
+        bundle_doc_key = (
+            doc_key if doc_key.startswith(f"{col_key}:") else f"{col_key}:{doc_key}"
+        )
+        doc_title = doc.title if hasattr(doc, "title") else doc["title"]
+        markdown = getattr(doc, "markdown", None) or (
+            doc.get("markdown") if isinstance(doc, dict) else ""
+        )
+        sections = split_markdown(markdown)
+        for section in sections:
+            sec_key = section_key(bundle_doc_key, section.path)
+            label = " › ".join([doc_title, *section.path])
+            choices.append((sec_key, label))
+
+    return choices
+
+
+def _bundle_document_key(collection_key: str, doc_key: str) -> str:
+    return (
+        doc_key
+        if doc_key.startswith(f"{collection_key}:")
+        else f"{collection_key}:{doc_key}"
+    )
+
+
+def build_bundle(
+    collection: Any,
+    documents: Iterable[Any],
+    glossary: Iterable[Any],
+    colloquial: Iterable[Any],
+    *,
+    fallback_heading: str = "Thông tin chung",
+) -> KnowledgeBundle:
+    """Build a deterministic KnowledgeBundle from authored content."""
+    col_key = collection.key if hasattr(collection, "key") else collection["key"]
+    col_title = (
+        collection.title if hasattr(collection, "title") else collection["title"]
+    )
+
+    sorted_input_docs = sorted(
+        documents,
+        key=lambda d: _bundle_document_key(
+            col_key, d.key if hasattr(d, "key") else d["key"]
+        ),
+    )
+
+    bundle_documents: list[DocumentRecord] = []
+    bundle_sections: list[SectionRecord] = []
+
+    for doc in sorted_input_docs:
+        doc_key = doc.key if hasattr(doc, "key") else doc["key"]
+        bundle_doc_key = _bundle_document_key(col_key, doc_key)
+        doc_title = doc.title if hasattr(doc, "title") else doc["title"]
+        kind = (
+            getattr(doc, "kind", None)
+            or (doc.get("kind") if isinstance(doc, dict) else None)
+            or DocumentKind.LEAFLET
+        )
+        if isinstance(kind, str):
+            kind = DocumentKind(kind)
+
+        if hasattr(doc, "source") and isinstance(doc.source, SourceInfo):
+            source = doc.source
+        else:
+            source_title = (
+                getattr(doc, "source_title", None)
+                or (doc.get("source_title") if isinstance(doc, dict) else None)
+                or doc_title
+            )
+            source_url = getattr(doc, "source_url", None) or (
+                doc.get("source_url") if isinstance(doc, dict) else None
+            )
+            source = SourceInfo(title=source_title, url=source_url)
+
+        attributes = (
+            getattr(doc, "attributes", None)
+            or (doc.get("attributes") if isinstance(doc, dict) else None)
+            or {}
+        )
+
+        bundle_documents.append(
+            DocumentRecord(
+                key=bundle_doc_key,
+                kind=kind,
+                title=doc_title,
+                source=source,
+                attributes=attributes,
+            )
+        )
+
+        markdown = getattr(doc, "markdown", None) or (
+            doc.get("markdown") if isinstance(doc, dict) else ""
+        )
+        sections = split_markdown(markdown, fallback_heading=fallback_heading)
+        for section in sections:
+            sec_key = section_key(bundle_doc_key, section.path)
+            bundle_sections.append(
+                SectionRecord(
+                    key=sec_key,
+                    document_key=bundle_doc_key,
+                    heading=section.heading,
+                    context_path=list(section.path),
+                    ordinal=section.ordinal,
+                    start_page=None,
+                    end_page=None,
+                    retrieval=RetrievalMode.DEFAULT,
+                    blocks=section.blocks,
+                )
+            )
+
+    glossary_records: list[GlossaryEntry] = [
+        entry
+        if isinstance(entry, GlossaryEntry)
+        else GlossaryEntry.model_validate(entry)
+        for entry in glossary
+    ]
+
+    all_section_keys = {s.key for s in bundle_sections}
+    colloquial_records: list[ColloquialMappingRecord] = []
+    for mapping in colloquial:
+        record = (
+            mapping
+            if isinstance(mapping, ColloquialMappingRecord)
+            else ColloquialMappingRecord.model_validate(mapping)
+        )
+        valid_keys = [k for k in record.section_keys if k in all_section_keys]
+        if not valid_keys:
+            continue
+        colloquial_records.append(
+            record.model_copy(update={"section_keys": valid_keys})
+        )
+
+    manifest = BundleManifest(
+        schema_version=BUNDLE_SCHEMA_VERSION,
+        collection=BundleCollection(key=col_key, title=col_title),
+        generator=BundleGenerator(
+            name="pharma-agent",
+            version="0.1.0",
+            build_id="authored",
+        ),
+        source_digests={},
+        document_count=len(bundle_documents),
+        section_count=len(bundle_sections),
+        files={},
+        embeddings=[],
+    )
+
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=bundle_documents,
+        sections=bundle_sections,
+        glossary=glossary_records,
+        colloquial_mappings=colloquial_records,
+    )
+
+
+__all__ = [
+    "AuthoredDocument",
+    "AuthoredSection",
+    "build_bundle",
+    "section_choices",
+    "section_key",
+    "slugify",
+    "split_markdown",
+]
