+import tempfile
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    AuthoredDocument,
+    AuthoredSection,
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    ColloquialMappingRecord,
+    DocumentKind,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import build_snapshot, bundle_digest
+
+
+def test_slugify_vietnamese_and_max_length() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("Liều lượng và cách dùng") == "lieu-luong-va-cach-dung"
+    assert (
+        slugify("Dược lý & Cơ chế tác dụng (Phần 1)!")
+        == "duoc-ly-co-che-tac-dung-phan-1"
+    )
+    assert (
+        slugify("Trẻ em, phụ nữ mang thai và cho con bú")
+        == "tre-em-phu-nu-mang-thai-va-cho-con-bu"
+    )
+    assert slugify("Đặc điểm lâm sàng") == "dac-diem-lam-sang"
+    assert slugify("hello world", max_length=5) == "hello"
+    assert slugify("hello world", max_length=8) == "hello-wo"
+    assert slugify("hello world", max_length=6) == "hello"
+
+
+def test_section_key_formatting() -> None:
+    doc_key = "formulary:paracetamol"
+    assert section_key(doc_key, ()) == "formulary:paracetamol#body"
+    assert section_key(doc_key, []) == "formulary:paracetamol#body"
+    assert section_key(doc_key, ("Liều dùng",)) == "formulary:paracetamol#lieu-dung"
+    assert (
+        section_key(doc_key, ("Liều dùng", "Đường uống"))
+        == "formulary:paracetamol#lieu-dung/duong-uong"
+    )
+
+
+def test_split_markdown_fallback_heading_and_empty_path() -> None:
+    md = "Đây là thông tin chung trước khi có tiêu đề."
+    sections = split_markdown(md, fallback_heading="Thông tin chung")
+
+    assert len(sections) == 1
+    sec = sections[0]
+    assert isinstance(sec, AuthoredSection)
+    assert sec.heading == "Thông tin chung"
+    assert sec.path == ()
+    assert sec.ordinal == 1
+    assert len(sec.blocks) == 1
+    assert sec.blocks[0].kind == BlockKind.PROSE
+    assert sec.blocks[0].markdown == "Đây là thông tin chung trước khi có tiêu đề."
+    assert sec.blocks[0].table_key is None
+
+
+def test_split_markdown_empty_and_whitespace_dropped() -> None:
+    assert split_markdown("", fallback_heading="T1") == []
+    assert split_markdown("   \n\n\t  ", fallback_heading="T1") == []
+
+
+def test_split_markdown_sections_with_no_content_are_dropped() -> None:
+    md = """
+# Rỗng 1
+# Rỗng 2
+# Có nội dung
+Nội dung ở đây.
+"""
+    sections = split_markdown(md, fallback_heading="Fallback")
+    assert len(sections) == 1
+    assert sections[0].heading == "Có nội dung"
+    assert sections[0].path == ("Có nội dung",)
+    assert sections[0].ordinal == 1
+    assert sections[0].blocks[0].markdown == "Nội dung ở đây."
+
+
+def test_split_markdown_headings_inside_fenced_code_ignored() -> None:
+    md = """
+# Tiêu đề 1
+
+Đoạn văn mở đầu.
+
+```python
+# Đây là comment không phải heading
+# Một comment khác
+def foo():
+    pass
+```
+
+Tiếp tục văn bản.
+
+# Tiêu đề 2
+Nội dung 2.
+"""
+    sections = split_markdown(md, fallback_heading="Fallback")
+    assert len(sections) == 2
+    assert sections[0].heading == "Tiêu đề 1"
+    assert sections[0].path == ("Tiêu đề 1",)
+    assert sections[0].ordinal == 1
+    assert len(sections[0].blocks) == 1
+    assert "def foo():" in sections[0].blocks[0].markdown
+    assert "# Đây là comment không phải heading" in sections[0].blocks[0].markdown
+
+    assert sections[1].heading == "Tiêu đề 2"
+    assert sections[1].path == ("Tiêu đề 2",)
+    assert sections[1].ordinal == 2
+
+
+def test_split_markdown_nested_heading_paths() -> None:
+    md = """
+Phần mở đầu không có tiêu đề.
+
+# Nhóm A
+Nội dung nhóm A.
+
+## Phân nhóm A1
+Nội dung A1.
+
+### Chi tiết A1a
+Nội dung chi tiết.
+
+## Phân nhóm A2
+Nội dung A2.
+
+# Nhóm B
+Nội dung nhóm B.
+"""
+    sections = split_markdown(md, fallback_heading="Tổng quan")
+    assert len(sections) == 6
+
+    # 1. Opening text
+    assert sections[0].heading == "Tổng quan"
+    assert sections[0].path == ()
+    assert sections[0].ordinal == 1
+
+    # 2. Group A
+    assert sections[1].heading == "Nhóm A"
+    assert sections[1].path == ("Nhóm A",)
+    assert sections[1].ordinal == 2
+
+    # 3. Subgroup A1
+    assert sections[2].heading == "Phân nhóm A1"
+    assert sections[2].path == ("Nhóm A", "Phân nhóm A1")
+    assert sections[2].ordinal == 3
+
+    # 4. Detail A1a
+    assert sections[3].heading == "Chi tiết A1a"
+    assert sections[3].path == ("Nhóm A", "Phân nhóm A1", "Chi tiết A1a")
+    assert sections[3].ordinal == 4
+
+    # 5. Subgroup A2
+    assert sections[4].heading == "Phân nhóm A2"
+    assert sections[4].path == ("Nhóm A", "Phân nhóm A2")
+    assert sections[4].ordinal == 5
+
+    # 6. Group B
+    assert sections[5].heading == "Nhóm B"
+    assert sections[5].path == ("Nhóm B",)
+    assert sections[5].ordinal == 6
+
+
+def test_split_markdown_table_blocks_and_prose() -> None:
+    md = """
+# Bảng và văn bản
+
+Đoạn văn trước bảng.
+
+| Cột 1 | Cột 2 |
+| :--- | ---: |
+| Dữ liệu 1 | 100 |
+| Dữ liệu 2 | 200 |
+
+Đoạn văn giữa 2 bảng.
+
+| Thuốc | Liều |
+| --- | --- |
+| Paracetamol | 500mg |
+
+# Mục tiếp theo
+
+Văn bản mục 2.
+
+| Nhãn | Giá trị |
+| --- | --- |
+| A | 1 |
+"""
+    sections = split_markdown(md, fallback_heading="Fallback")
+    assert len(sections) == 2
+
+    s1 = sections[0]
+    assert s1.heading == "Bảng và văn bản"
+    assert len(s1.blocks) == 4
+
+    assert s1.blocks[0].kind == BlockKind.PROSE
+    assert s1.blocks[0].markdown == "Đoạn văn trước bảng."
+    assert s1.blocks[0].table_key is None
+
+    assert s1.blocks[1].kind == BlockKind.TABLE
+    assert s1.blocks[1].table_key == "t1"
+    assert "| Dữ liệu 1 | 100 |" in s1.blocks[1].markdown
+
+    assert s1.blocks[2].kind == BlockKind.PROSE
+    assert s1.blocks[2].markdown == "Đoạn văn giữa 2 bảng."
+    assert s1.blocks[2].table_key is None
+
+    assert s1.blocks[3].kind == BlockKind.TABLE
+    assert s1.blocks[3].table_key == "t2"
+    assert "| Paracetamol | 500mg |" in s1.blocks[3].markdown
+
+    s2 = sections[1]
+    assert s2.heading == "Mục tiếp theo"
+    assert len(s2.blocks) == 2
+
+    assert s2.blocks[0].kind == BlockKind.PROSE
+    assert s2.blocks[0].markdown == "Văn bản mục 2."
+
+    # Numbered across the whole document: next table is t3
+    assert s2.blocks[1].kind == BlockKind.TABLE
+    assert s2.blocks[1].table_key == "t3"
+
+
+def test_section_choices_labels_and_reading_order() -> None:
+    collection = {"key": "col1", "title": "Bộ sưu tập 1"}
+    docs = [
+        AuthoredDocument(
+            key="doc1",
+            title="Paracetamol",
+            markdown="Lời nói đầu.\n# Chỉ định\nGiảm đau.\n## Người lớn\nUống 500mg.",
+        ),
+        AuthoredDocument(
+            key="doc2",
+            title="Ibuprofen",
+            markdown="# Liều lượng\nUống sau ăn.",
+        ),
+    ]
+
+    choices = section_choices(collection, docs)
+    assert choices == [
+        ("col1:doc1#body", "Paracetamol"),
+        ("col1:doc1#chi-dinh", "Paracetamol › Chỉ định"),
+        ("col1:doc1#chi-dinh/nguoi-lon", "Paracetamol › Chỉ định › Người lớn"),
+        ("col1:doc2#lieu-luong", "Ibuprofen › Liều lượng"),
+    ]
+
+
+def test_build_bundle_documents_sorted_and_deterministic() -> None:
+    collection = {"key": "cl-auth", "title": "Authoring Collection"}
+    docs = [
+        AuthoredDocument(
+            key="z-doc",
+            title="Zebra Drug",
+            markdown="# Tác dụng\nTác dụng tốt.",
+        ),
+        AuthoredDocument(
+            key="a-doc",
+            title="Alpha Drug",
+            markdown="Thông tin chung.\n# Liều\n1 viên mỗi ngày.",
+        ),
+    ]
+    glossary = [
+        GlossaryEntry(
+            term="NSAID",
+            vietnamese_expansions=["thuốc chống viêm"],
+        )
+    ]
+    colloquial = [
+        ColloquialMappingRecord(
+            key="alpha-map",
+            aliases=["thuốc alpha"],
+            section_keys=["cl-auth:a-doc#body"],
+        ),
+        ColloquialMappingRecord(
+            key="missing-map",
+            aliases=["không tồn tại"],
+            section_keys=["cl-auth:non-existent#section"],
+        ),
+    ]
+
+    bundle1 = build_bundle(collection, docs, glossary, colloquial)
+    bundle2 = build_bundle(collection, docs, glossary, colloquial)
+
+    # Determinism: same content -> same bundle digest
+    digest1 = bundle_digest(bundle1)
+    digest2 = bundle_digest(bundle2)
+    assert digest1 == digest2
+
+    # Manifest checks
+    assert bundle1.manifest.collection.key == "cl-auth"
+    assert bundle1.manifest.collection.title == "Authoring Collection"
+    assert bundle1.manifest.document_count == 2
+    assert bundle1.manifest.section_count == 3  # a-doc has 2, z-doc has 1
+
+    # Documents sorted by key
+    assert [d.key for d in bundle1.documents] == [
+        "cl-auth:a-doc",
+        "cl-auth:z-doc",
+    ]
+
+    # Sections in document order
+    assert [s.key for s in bundle1.sections] == [
+        "cl-auth:a-doc#body",
+        "cl-auth:a-doc#lieu",
+        "cl-auth:z-doc#tac-dung",
+    ]
+
+    # Glossary as given
+    assert bundle1.glossary == glossary
+
+    # Colloquial mapping with non-existent section key is removed
+    assert len(bundle1.colloquial_mappings) == 1
+    assert bundle1.colloquial_mappings[0].key == "alpha-map"
+    assert bundle1.colloquial_mappings[0].section_keys == ["cl-auth:a-doc#body"]
+
