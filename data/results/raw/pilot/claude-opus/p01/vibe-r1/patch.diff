@@ -0,0 +1,174 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    build_bundle,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BlockKind,
+    ColloquialMappingRecord,
+    DocumentKind,
+    GlossaryEntry,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import Collection, build_snapshot, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+
+NOW = datetime(2026, 10, 11, tzinfo=UTC)
+COLLECTION = Collection(id=uuid.uuid4(), key="clinic", title="Phòng khám")
+
+PARACETAMOL = """Giới thiệu chung.
+
+# Paracetamol
+
+## Liều dùng
+
+### Đường uống
+
+Người lớn: 500 mg.
+
+| Tuổi | Liều |
+|---|---|
+| > 12 | 500 mg |
+
+Ghi chú sau bảng.
+
+| A | B |
+
+```
+# not a heading
+| not a table |
+```
+
+## Trống
+
+## Chống chỉ định
+Suy gan nặng.
+"""
+
+
+def _document(key: str, title: str, markdown: str) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid4(),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.DRUG_MONOGRAPH,
+        source_title="",
+        source_url=None,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=NOW,
+        updated_by=None,
+        updated_at=NOW,
+    )
+
+
+def test_split_markdown_builds_sections_paths_and_blocks() -> None:
+    sections = split_markdown(PARACETAMOL, fallback_heading="Paracetamol")
+
+    assert [(s.heading, s.path, s.ordinal) for s in sections] == [
+        ("Paracetamol", (), 1),
+        ("Đường uống", ("Paracetamol", "Liều dùng", "Đường uống"), 2),
+        ("Chống chỉ định", ("Paracetamol", "Chống chỉ định"), 3),
+    ]
+    assert sections[0].blocks[0].markdown == "Giới thiệu chung."
+    blocks = sections[1].blocks
+    assert [(b.kind, b.table_key) for b in blocks] == [
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t1"),
+        (BlockKind.PROSE, None),
+        (BlockKind.TABLE, "t2"),
+        (BlockKind.PROSE, None),
+    ]
+    assert blocks[0].markdown == "Người lớn: 500 mg."
+    assert blocks[1].markdown == "| Tuổi | Liều |\n|---|---|\n| > 12 | 500 mg |"
+    assert blocks[4].markdown == "```\n# not a heading\n| not a table |\n```"
+
+
+def test_split_markdown_without_headings_uses_the_fallback() -> None:
+    sections = split_markdown("Chỉ có văn bản.", fallback_heading="Ghi chú")
+    assert [(s.heading, s.path) for s in sections] == [("Ghi chú", ())]
+    assert split_markdown("  \n", fallback_heading="x") == []
+
+
+def test_table_keys_are_numbered_across_sections() -> None:
+    sections = split_markdown("# A\n| 1 |\n# B\n| 2 |", fallback_heading="x")
+    assert [s.blocks[0].table_key for s in sections] == ["t1", "t2"]
+
+
+def test_slugify_and_section_key() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Liều dùng — Trẻ em (≥ 12 tuổi) ") == "lieu-dung-tre-em-12-tuoi"
+    assert slugify("alpha beta gamma", max_length=12) == "alpha-beta"
+    assert len(slugify("x" * 200)) == 80
+    assert section_key("c:doc", ()) == "c:doc#body"
+    assert section_key("c:doc", ("Paracetamol", "Đường uống")) == (
+        "c:doc#paracetamol/duong-uong"
+    )
+
+
+def test_section_choices_follow_reading_order() -> None:
+    choices = section_choices(COLLECTION, [_document("para", "Para", PARACETAMOL)])
+    assert choices == [
+        ("clinic:para#body", "Para"),
+        (
+            "clinic:para#paracetamol/lieu-dung/duong-uong",
+            "Para › Paracetamol › Liều dùng › Đường uống",
+        ),
+        (
+            "clinic:para#paracetamol/chong-chi-dinh",
+            "Para › Paracetamol › Chống chỉ định",
+        ),
+    ]
+
+
+def test_repeated_heading_paths_get_unique_keys() -> None:
+    choices = section_choices(
+        COLLECTION, [_document("d", "D", "# Ghi chú\na\n# Ghi chú\nb")]
+    )
+    assert [key for key, _ in choices] == ["clinic:d#ghi-chu", "clinic:d#ghi-chu-2"]
+
+
+def test_build_bundle_is_deterministic_and_valid(tmp_path: Path) -> None:
+    documents = [
+        _document("zeta", "Zeta", "# Z\nNội dung."),
+        _document("para", "Para", PARACETAMOL),
+    ]
+    glossary = [GlossaryEntry(term="PO", vietnamese_expansions=["đường uống"])]
+    colloquial = [
+        ColloquialMappingRecord(
+            key="hapa",
+            aliases=["thuốc hạ sốt"],
+            section_keys=["clinic:para#body", "clinic:para#missing"],
+        )
+    ]
+
+    bundle = build_bundle(COLLECTION, documents, glossary, colloquial)
+
+    assert [d.key for d in bundle.documents] == ["clinic:para", "clinic:zeta"]
+    assert bundle.documents[0].source.title == "Para"
+    assert len(bundle.sections) == 4
+    assert bundle.glossary == glossary
+    assert bundle.colloquial_mappings[0].section_keys == ["clinic:para#body"]
+    manifest = bundle.manifest
+    assert (manifest.collection.key, manifest.collection.title) == (
+        "clinic",
+        "Phòng khám",
+    )
+    assert (manifest.document_count, manifest.section_count) == (2, 4)
+
+    again = build_bundle(COLLECTION, list(reversed(documents)), glossary, colloquial)
+    assert again == bundle
+    assert bundle_digest(again) == bundle_digest(bundle)
+
+    write_bundle(bundle, tmp_path)
+    assert bundle_digest(read_bundle(tmp_path)) == bundle_digest(bundle)
+    build_snapshot(bundle)
