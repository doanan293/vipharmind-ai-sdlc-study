+"""Knowledge bundles from authored Markdown (spec §4.7).
+
+Authored documents are split into sections at their ATX headings; each section's
+tables and prose become ``BlockRecord`` values, and ``build_bundle`` assembles a
+deterministic ``KnowledgeBundle`` that goes through the existing bundle import.
+"""
+
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    BundleGenerator,
+    BundleManifest,
+    ColloquialMappingRecord,
+    DocumentRecord,
+    GlossaryEntry,
+    KnowledgeBundle,
+    SectionRecord,
+    SourceInfo,
+)
+from pharma_agent.domain.corpus.models import Collection
+from pharma_agent.domain.corpus.source import SourceDocument
+
+_HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*?))?[ \t]*$")
+_CLOSING_HASHES_RE = re.compile(r"(?:^|[ \t]+)#+$")
+_FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_NON_ALNUM_RE = re.compile(r"[^a-z0-9]+")
+BODY_SECTION_SLUG = "body"
+LABEL_SEPARATOR = " › "
+GENERATOR = BundleGenerator(
+    name="pharma-agent-authoring", version="1", build_id="authoring"
+)
+
+
+@dataclass(frozen=True)
+class MarkdownSection:
+    heading: str
+    path: tuple[str, ...]
+    ordinal: int
+    blocks: tuple[BlockRecord, ...]
+
+
+@dataclass
+class _RawSection:
+    heading: str
+    path: tuple[str, ...]
+    lines: list[tuple[str, bool]]  # (line, inside a fenced code block)
+
+
+def slugify(text: str, *, max_length: int = 80) -> str:
+    """Lowercase ASCII words joined by hyphens; Vietnamese marks are removed.
+
+    The result is cut at a hyphen when it is longer than `max_length`; it may be empty
+    when `text` has no Latin letters or digits.
+    """
+    decomposed = unicodedata.normalize("NFKD", text.replace("Đ", "D").replace("đ", "d"))
+    ascii_text = decomposed.encode("ascii", "ignore").decode("ascii").lower()
+    slug = _NON_ALNUM_RE.sub("-", ascii_text).strip("-")
+    if len(slug) <= max_length:
+        return slug
+    cut = slug[: max_length + 1]
+    boundary = cut.rfind("-")
+    return (cut[:boundary] if boundary > 0 else slug[:max_length]).strip("-")
+
+
+def section_key(document_key: str, path: Sequence[str]) -> str:
+    """``<document_key>#<slug>/<slug>…``, or ``<document_key>#body`` for an empty path."""
+    if not path:
+        return f"{document_key}#{BODY_SECTION_SLUG}"
+    return f"{document_key}#" + "/".join(slugify(part) for part in path)
+
+
+def bundle_document_key(collection_key: str, document_key: str) -> str:
+    """Unique across collections, so chunk ids never collide."""
+    return f"{collection_key}:{document_key}"
+
+
+def split_markdown(markdown: str, *, fallback_heading: str) -> list[MarkdownSection]:
+    """Sections in reading order; empty ones are dropped and ordinals start at 1.
+
+    `path` holds the enclosing headings ending with the section's own heading; text
+    before the first heading forms a section titled `fallback_heading` with an empty
+    path. Headings and table rows inside fenced code do not count.
+    """
+    raw_sections = [_RawSection(fallback_heading, (), [])]
+    stack: list[tuple[int, str]] = []
+    fence: str | None = None
+    for line in markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
+        fence_match = _FENCE_RE.match(line)
+        if fence is not None:
+            raw_sections[-1].lines.append((line, True))
+            if fence_match and fence_match.group(1).startswith(fence):
+                fence = None
+            continue
+        if fence_match:
+            fence = fence_match.group(1)[0] * 3
+            raw_sections[-1].lines.append((line, True))
+            continue
+        heading_match = _HEADING_RE.match(line)
+        if heading_match:
+            level = len(heading_match.group(1))
+            heading = _CLOSING_HASHES_RE.sub("", heading_match.group(2) or "").strip()
+            while stack and stack[-1][0] >= level:
+                stack.pop()
+            stack.append((level, heading))
+            raw_sections.append(
+                _RawSection(heading, tuple(text for _, text in stack), [])
+            )
+            continue
+        raw_sections[-1].lines.append((line, False))
+
+    sections: list[MarkdownSection] = []
+    table_count = 0
+    for raw in raw_sections:
+        blocks, table_count = _blocks(raw.lines, table_count)
+        if blocks:
+            sections.append(
+                MarkdownSection(raw.heading, raw.path, len(sections) + 1, blocks)
+            )
+    return sections
+
+
+def _blocks(
+    lines: list[tuple[str, bool]], table_count: int
+) -> tuple[tuple[BlockRecord, ...], int]:
+    blocks: list[BlockRecord] = []
+    prose: list[str] = []
+    rows: list[str] = []
+
+    def flush_prose() -> None:
+        text = "\n".join(line.rstrip() for line in prose).strip()
+        if text:
+            blocks.append(BlockRecord(kind=BlockKind.PROSE, markdown=text))
+        prose.clear()
+
+    def flush_table() -> None:
+        nonlocal table_count
+        if rows:
+            table_count += 1
+            blocks.append(
+                BlockRecord(
+                    kind=BlockKind.TABLE,
+                    markdown="\n".join(row.strip() for row in rows),
+                    table_key=f"t{table_count}",
+                )
+            )
+        rows.clear()
+
+    for line, fenced in lines:
+        if not fenced and line.lstrip().startswith("|"):
+            if not rows:
+                flush_prose()
+            rows.append(line)
+        else:
+            flush_table()
+            prose.append(line)
+    flush_table()
+    flush_prose()
+    return tuple(blocks), table_count
+
+
+def section_choices(
+    collection: Collection, documents: Sequence[SourceDocument]
+) -> list[tuple[str, str]]:
+    """(section key, label) pairs in reading order, documents in the given order.
+
+    The label is the document title followed by the heading path, joined by " › ".
+    """
+    return [
+        (key, LABEL_SEPARATOR.join((document.title, *section.path)))
+        for document in documents
+        for key, section in _keyed_sections(collection, document)
+    ]
+
+
+def build_bundle(
+    collection: Collection,
+    documents: Sequence[SourceDocument],
+    glossary: Sequence[GlossaryEntry],
+    colloquial: Sequence[ColloquialMappingRecord],
+) -> KnowledgeBundle:
+    """A deterministic bundle of the collection's authored content.
+
+    Documents are sorted by bundle key and their sections follow in reading order; the
+    glossary is kept as given and colloquial mappings lose unknown section keys.
+    """
+    ordered = sorted(
+        documents,
+        key=lambda document: bundle_document_key(collection.key, document.key),
+    )
+    document_records: list[DocumentRecord] = []
+    section_records: list[SectionRecord] = []
+    for document in ordered:
+        document_key = bundle_document_key(collection.key, document.key)
+        document_records.append(
+            DocumentRecord(
+                key=document_key,
+                kind=document.kind,
+                title=document.title,
+                source=SourceInfo(title=document.source_title, url=document.source_url),
+            )
+        )
+        section_records.extend(
+            SectionRecord(
+                key=key,
+                document_key=document_key,
+                heading=section.heading,
+                context_path=list(section.path) or [section.heading],
+                ordinal=section.ordinal,
+                blocks=list(section.blocks),
+            )
+            for key, section in _keyed_sections(collection, document)
+        )
+    known = {section.key for section in section_records}
+    mappings = [
+        mapping.model_copy(
+            update={"section_keys": [k for k in mapping.section_keys if k in known]}
+        )
+        for mapping in colloquial
+    ]
+    manifest = BundleManifest(
+        schema_version=BUNDLE_SCHEMA_VERSION,
+        collection=BundleCollection(key=collection.key, title=collection.title),
+        generator=GENERATOR,
+        source_digests={},
+        document_count=len(document_records),
+        section_count=len(section_records),
+        files={},
+    )
+    return KnowledgeBundle(
+        manifest=manifest,
+        documents=document_records,
+        sections=section_records,
+        glossary=list(glossary),
+        colloquial_mappings=mappings,
+    )
+
+
+def _keyed_sections(
+    collection: Collection, document: SourceDocument
+) -> list[tuple[str, MarkdownSection]]:
+    """Sections with their keys; a repeated key gets "-2", "-3", … appended."""
+    document_key = bundle_document_key(collection.key, document.key)
+    taken: set[str] = set()
+    keyed: list[tuple[str, MarkdownSection]] = []
+    for section in split_markdown(document.markdown, fallback_heading=document.title):
+        base = section_key(document_key, section.path)
+        key = base
+        suffix = 1
+        while key in taken:
+            suffix += 1
+            key = f"{base}-{suffix}"
+        taken.add(key)
+        keyed.append((key, section))
+    return keyed
