@@ -0,0 +1,307 @@
+import uuid
+from datetime import UTC, datetime
+from pathlib import Path
+
+from pharma_agent.domain.corpus.authoring import (
+    MarkdownSection,
+    build_bundle,
+    bundle_document_key,
+    section_choices,
+    section_key,
+    slugify,
+    split_markdown,
+)
+from pharma_agent.domain.corpus.bundle import (
+    BUNDLE_SCHEMA_VERSION,
+    BlockKind,
+    BlockRecord,
+    BundleCollection,
+    ColloquialMappingRecord,
+    DocumentKind,
+    DocumentRecord,
+    GlossaryEntry,
+    SectionRecord,
+    SourceInfo,
+    read_bundle,
+    write_bundle,
+)
+from pharma_agent.domain.corpus.models import Collection, bundle_digest
+from pharma_agent.domain.corpus.source import SourceDocument
+
+NOW = datetime(2026, 1, 1, tzinfo=UTC)
+COLLECTION = Collection(id=uuid.UUID(int=1), key="notes", title="Ghi chú")
+
+
+def prose(text: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.PROSE, markdown=text)
+
+
+def table(text: str, key: str) -> BlockRecord:
+    return BlockRecord(kind=BlockKind.TABLE, markdown=text, table_key=key)
+
+
+# --- split_markdown -------------------------------------------------------------
+
+
+def test_split_builds_heading_paths() -> None:
+    markdown = (
+        "Intro text.\n\n"
+        "# Dosage\n\nAdults: 500 mg.\n\n"
+        "## Children\nHalf dose.\n\n"
+        "### Infants\nAsk a doctor.\n\n"
+        "## Elderly\nNo change.\n\n"
+        "# Warnings\nDo not exceed.\n"
+    )
+
+    sections = split_markdown(markdown, fallback_heading="Paracetamol")
+
+    assert sections == [
+        MarkdownSection("Paracetamol", (), 1, (prose("Intro text."),)),
+        MarkdownSection("Dosage", ("Dosage",), 2, (prose("Adults: 500 mg."),)),
+        MarkdownSection("Children", ("Dosage", "Children"), 3, (prose("Half dose."),)),
+        MarkdownSection(
+            "Infants",
+            ("Dosage", "Children", "Infants"),
+            4,
+            (prose("Ask a doctor."),),
+        ),
+        MarkdownSection("Elderly", ("Dosage", "Elderly"), 5, (prose("No change."),)),
+        MarkdownSection("Warnings", ("Warnings",), 6, (prose("Do not exceed."),)),
+    ]
+
+
+def test_split_without_headings_gives_one_fallback_section() -> None:
+    sections = split_markdown("  Just text.\nMore.  \n", fallback_heading="Doc")
+
+    assert sections == [MarkdownSection("Doc", (), 1, (prose("Just text.\nMore."),))]
+
+
+def test_split_ignores_headings_in_fenced_code() -> None:
+    markdown = "# Real\n```\n# not a heading\n| not | table |\n```\n~~~\n## nope\n~~~\n"
+
+    sections = split_markdown(markdown, fallback_heading="Doc")
+
+    assert [section.heading for section in sections] == ["Real"]
+    assert sections[0].blocks == (
+        prose("```\n# not a heading\n| not | table |\n```\n~~~\n## nope\n~~~"),
+    )
+
+
+def test_split_drops_empty_sections_but_keeps_their_path() -> None:
+    markdown = "\n\n# Parent\n\n## Child\nBody.\n# Empty\n   \n"
+
+    sections = split_markdown(markdown, fallback_heading="Doc")
+
+    assert sections == [
+        MarkdownSection("Child", ("Parent", "Child"), 1, (prose("Body."),))
+    ]
+
+
+def test_split_strips_closing_hashes_from_headings() -> None:
+    sections = split_markdown("## Liều dùng ##\ntext", fallback_heading="Doc")
+
+    assert sections[0].heading == "Liều dùng"
+
+
+def test_split_turns_table_runs_into_numbered_table_blocks() -> None:
+    markdown = (
+        "# A\n"
+        "Before.\n"
+        "| x | y |\n|---|---|\n| 1 | 2 |\n"
+        "\nBetween.\n\n"
+        "| p |\n|---|\n"
+        "# B\n"
+        "| q |\n|---|\n"
+        "After.\n"
+    )
+
+    sections = split_markdown(markdown, fallback_heading="Doc")
+
+    assert sections[0].blocks == (
+        prose("Before."),
+        table("| x | y |\n|---|---|\n| 1 | 2 |", "t1"),
+        prose("Between."),
+        table("| p |\n|---|", "t2"),
+    )
+    assert sections[1].blocks == (table("| q |\n|---|", "t3"), prose("After."))
+
+
+def test_split_empty_document_has_no_sections() -> None:
+    assert split_markdown("   \n", fallback_heading="Doc") == []
+
+
+# --- slugify and keys -----------------------------------------------------------
+
+
+def test_slugify_removes_vietnamese_marks() -> None:
+    assert slugify("Đường uống") == "duong-uong"
+    assert slugify("  Liều lượng & cách dùng (người lớn)!  ") == (
+        "lieu-luong-cach-dung-nguoi-lon"
+    )
+    assert slugify("Tương tác thuốc – ĐƯỜNG Tĩnh mạch") == (
+        "tuong-tac-thuoc-duong-tinh-mach"
+    )
+    assert slugify("日本語 ???") == ""
+
+
+def test_slugify_limits_length_without_trailing_hyphen() -> None:
+    assert slugify("abc def ghi", max_length=7) == "abc-def"
+    assert slugify("abc def ghi", max_length=8) == "abc-def"
+    assert slugify("abcdefghij", max_length=4) == "abcd"
+    assert len(slugify("word " * 40)) <= 80
+
+
+def test_section_key_joins_slugified_path() -> None:
+    assert section_key("c:doc", ()) == "c:doc#body"
+    assert section_key("c:doc", ["Liều dùng", "Trẻ em"]) == "c:doc#lieu-dung/tre-em"
+
+
+def test_bundle_document_key_prefixes_collection() -> None:
+    assert bundle_document_key("formulary", "paracetamol") == "formulary:paracetamol"
+
+
+# --- section_choices and build_bundle -------------------------------------------
+
+
+def make_document(
+    key: str, title: str, markdown: str, *, url: str | None = None
+) -> SourceDocument:
+    return SourceDocument(
+        id=uuid.uuid5(uuid.NAMESPACE_URL, key),
+        collection_id=COLLECTION.id,
+        key=key,
+        title=title,
+        kind=DocumentKind.LEAFLET,
+        source_title="Tờ hướng dẫn",
+        source_url=url,
+        markdown=markdown,
+        char_count=len(markdown),
+        created_by=None,
+        created_at=NOW,
+        updated_by=None,
+        updated_at=NOW,
+    )
+
+
+PANADOL = make_document(
+    "panadol",
+    "Panadol",
+    "Giảm đau.\n# Liều dùng\n## Đường uống\n| a |\n|---|\nUống sau ăn.\n",
+    url="https://example.test/panadol",
+)
+ASPIRIN = make_document("aspirin", "Aspirin", "# Chống chỉ định\nLoét dạ dày.\n")
+GLOSSARY = [
+    GlossaryEntry(term="NSAID", english_expansions=["non-steroidal"]),
+    GlossaryEntry(term="ADR"),
+]
+
+
+def test_section_choices_lists_sections_in_reading_order() -> None:
+    assert section_choices(COLLECTION, [PANADOL, ASPIRIN]) == [
+        ("notes:panadol#body", "Panadol"),
+        ("notes:panadol#lieu-dung/duong-uong", "Panadol › Liều dùng › Đường uống"),
+        ("notes:aspirin#chong-chi-dinh", "Aspirin › Chống chỉ định"),
+    ]
+
+
+def test_section_choices_keep_repeated_headings_apart() -> None:
+    document = make_document("faq", "FAQ", "# Q\none\n# Q\ntwo\n# Q\nthree\n")
+
+    keys = [key for key, _ in section_choices(COLLECTION, [document])]
+
+    assert keys == ["notes:faq#q", "notes:faq#q-2", "notes:faq#q-3"]
+    bundle = build_bundle(COLLECTION, [document], [], [])
+    assert [section.key for section in bundle.sections] == keys
+
+
+def test_build_bundle_records() -> None:
+    colloquial = [
+        ColloquialMappingRecord(
+            key="panadol",
+            aliases=["thuốc đỏ"],
+            section_keys=["notes:panadol#lieu-dung/duong-uong", "notes:gone#body"],
+        ),
+        ColloquialMappingRecord(key="old", section_keys=["notes:old#body"]),
+    ]
+
+    bundle = build_bundle(COLLECTION, [PANADOL, ASPIRIN], GLOSSARY, colloquial)
+
+    assert bundle.documents == [
+        DocumentRecord(
+            key="notes:aspirin",
+            kind=DocumentKind.LEAFLET,
+            title="Aspirin",
+            source=SourceInfo(title="Tờ hướng dẫn"),
+        ),
+        DocumentRecord(
+            key="notes:panadol",
+            kind=DocumentKind.LEAFLET,
+            title="Panadol",
+            source=SourceInfo(title="Tờ hướng dẫn", url="https://example.test/panadol"),
+        ),
+    ]
+    assert bundle.sections == [
+        SectionRecord(
+            key="notes:aspirin#chong-chi-dinh",
+            document_key="notes:aspirin",
+            heading="Chống chỉ định",
+            context_path=["Chống chỉ định"],
+            ordinal=1,
+            blocks=[prose("Loét dạ dày.")],
+        ),
+        SectionRecord(
+            key="notes:panadol#body",
+            document_key="notes:panadol",
+            heading="Panadol",
+            context_path=["Panadol"],
+            ordinal=1,
+            blocks=[prose("Giảm đau.")],
+        ),
+        SectionRecord(
+            key="notes:panadol#lieu-dung/duong-uong",
+            document_key="notes:panadol",
+            heading="Đường uống",
+            context_path=["Liều dùng", "Đường uống"],
+            ordinal=2,
+            blocks=[table("| a |\n|---|", "t1"), prose("Uống sau ăn.")],
+        ),
+    ]
+    assert bundle.glossary == GLOSSARY
+    assert bundle.colloquial_mappings == [
+        ColloquialMappingRecord(
+            key="panadol",
+            aliases=["thuốc đỏ"],
+            section_keys=["notes:panadol#lieu-dung/duong-uong"],
+        ),
+        ColloquialMappingRecord(key="old", section_keys=[]),
+    ]
+    assert colloquial[0].section_keys[1] == "notes:gone#body"  # input untouched
+
+
+def test_build_bundle_manifest() -> None:
+    manifest = build_bundle(COLLECTION, [PANADOL, ASPIRIN], GLOSSARY, []).manifest
+
+    assert manifest.schema_version == BUNDLE_SCHEMA_VERSION
+    assert manifest.collection == BundleCollection(key="notes", title="Ghi chú")
+    assert manifest.document_count == 2
+    assert manifest.section_count == 3
+
+
+def test_build_bundle_passes_bundle_validation(tmp_path: Path) -> None:
+    bundle = build_bundle(COLLECTION, [PANADOL, ASPIRIN], GLOSSARY, [])
+
+    write_bundle(bundle, tmp_path)
+
+    assert bundle_digest(read_bundle(tmp_path)) == bundle_digest(bundle)
+
+
+def test_build_bundle_is_deterministic() -> None:
+    first = build_bundle(COLLECTION, [PANADOL, ASPIRIN], GLOSSARY, [])
+    second = build_bundle(COLLECTION, [ASPIRIN, PANADOL], list(GLOSSARY), [])
+
+    assert first == second
+    assert bundle_digest(first) == bundle_digest(second)
+
+    edited = make_document("aspirin", "Aspirin", "# Chống chỉ định\nLoét.\n")
+    changed = build_bundle(COLLECTION, [PANADOL, edited], GLOSSARY, [])
+    assert bundle_digest(changed) != bundle_digest(first)
